{
  "name": "oots-france",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "build": "npm test",
    "test": "eslint . && NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest",
    "test:e2e": "NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest --config jest.e2e.js",
    "test:watch": "NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest --watchAll",
    "start": "node server.js"
  },
  "author": "",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.8.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "globals": "^17.9.0",
    "jest": "^30.4.2"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.10.1",
    "jose": "^6.2.8"
  },
  "jest": {
    "testTimeout": 1000,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.worktrees/",
      "/test-e2e/"
    ]
  }
}
