    "eslint-plugin-no-only-tests": "^3.4.0",
    "globals": "^17.9.0",
    "jest": "^29.5.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "express": "^4.21.1",
    "fast-xml-parser": "^5.10.1",
    "jose": "^5.2.0",
