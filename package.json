{
  "name": "oots-france",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "migre": "node node_modules/node-pg-migrate/bin/node-pg-migrate.js --database-url-var URL_BASE_DONNEES_MIGRATION up",
    "journal": "node scripts/consulteJournal.js",
    "purgeJournal": "node scripts/purgeJournal.js",
    "test": "eslint . && NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest",
    "test:e2e": "NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest --config jest.e2e.js",
    "test:watch": "NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest --watchAll",
    "start": "node server.js"
  },
  "author": "",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=26.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.8.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "globals": "^17.9.0",
    "jest": "^30.4.2"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.10.1",
    "jose": "^6.2.8",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0"
  },
  "jest": {
    "testTimeout": 1000,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.worktrees/",
      "/test-e2e/"
    ]
  },
  "overrides": {
    "picomatch": "^4.0.5",
    "brace-expansion": "^2.0.2"
  }
}
