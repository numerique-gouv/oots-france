<%= render SiteHeaderComponent.new(
      logo_text: t('layouts.logo_html'),
      title: t('layouts.application.name'),
      badge: t('layouts.entete.badge'),
      tagline: t('layouts.entete.tagline'),
      href: root_path,
    ) do |header| %>
  <% if presentation_page? %>
    <%# The anchors lead back to the front page from the page of available
        evidence, which carries the same menu. %>
    <% anchor_base = current_page?(root_path) ? '' : root_path %>
    <% { in_brief: "#{anchor_base}#comprendre", how_it_works: "#{anchor_base}#fonctionnement",
         concerned: "#{anchor_base}#concerne", available_evidence: available_evidence_index_path,
         connecting: "#{anchor_base}#raccorder", faq: "#{anchor_base}#faq" }.each do |section, path| %>
      <% header.with_direct_link_simple(title: t("layouts.entete.navigation.#{section}"), path:) %>
    <% end %>
    <% header.with_tool_link(title: t('layouts.entete.contact'), path: team_mail_address,
         html_attributes: { class: 'fr-icon-mail-line' }) %>
    <% header.with_tool_link(title: t('layouts.entete.admin_space'), path: admin_root_path,
         html_attributes: { class: 'fr-btn--account' }) %>
  <% end %>
  <% if admin_section? %>
    <% header.with_direct_link_simple(title: t('layouts.entete.directories'), path: admin_common_services_root_path) %>
    <% if named_administrator? %>
      <% header.with_direct_link_simple(title: t('layouts.entete.journal'), path: admin_journal_root_path) %>
      <% header.with_direct_link_simple(title: t('layouts.entete.jobs'), path: admin_jobs_path) %>
    <% end %>
    <% header.with_direct_link_simple(title: t('layouts.entete.demo'), path: admin_demo_root_path) %>

    <%# The agent signed in, as the DSFR header shows an account: an icon and a
        name among the quick access links. Not a link, there being no account
        page to lead to. %>
    <% if signed_in_email %>
      <% header.with_custom_tool_link do %>
        <%= tag.p signed_in_email, class: 'fr-btn fr-icon-account-circle-line',
              title: t('layouts.entete.signed_in_as', email: signed_in_email) %>
      <% end %>
    <% end %>
    <%# `button_to`, because the application embarks neither Turbo nor
        `rails-ujs`: a `method: :delete` on an anchor would do nothing. And a
        custom tool link rather than `with_tool_link`, whose component renders an
        `<a>` and nothing else. %>
    <% header.with_custom_tool_link do %>
      <%= button_to t('layouts.entete.sign_out'), admin_session_path, method: :delete, class: 'fr-btn' %>
    <% end %>
  <% end %>
<% end %>
