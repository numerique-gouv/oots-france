<footer class="fr-footer" role="contentinfo" id="pied-de-page">
  <div class="fr-container">
    <div class="fr-footer__body">
      <div class="fr-footer__brand fr-enlarge-link">
        <p class="fr-logo"><%= t('layouts.logo_html') %></p>
      </div>
      <div class="fr-footer__content">
        <p class="fr-footer__content-desc">
          <%= t('layouts.pied_de_page.about_html',
                tdd: link_to(t('layouts.pied_de_page.tdd'),
                  'https://ec.europa.eu/digital-building-blocks/sites/spaces/TDD/overview',
                  target: '_blank', rel: 'noopener')) %>
        </p>
        <ul class="fr-footer__content-list">
          <li class="fr-footer__content-item">
            <a class="fr-footer__content-link" href="https://www.numerique.gouv.fr" target="_blank" rel="noopener">numerique.gouv.fr</a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</footer>
