<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-fr-scheme="system">
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title).presence || t('layouts.application.name') %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# The State's brand, as the DSFR ships it and `data_pass` serves it. The
        manifest the DSFR attaches is not reused: its icons are named there by a
        path within the distribution, and Propshaft serves ours under a
        digest. %>
    <link rel="apple-touch-icon" href="<%= image_url('favicons/apple-touch-icon.png') %>">
    <link rel="icon" href="<%= image_url('favicons/favicon.svg') %>" type="image/svg+xml">
    <link rel="shortcut icon" href="<%= image_url('favicons/favicon.ico') %>" type="image/x-icon">
    <%# `dsfr.min` carries the core and the components, and not the icons:
        those live in the utility sheet, and every `fr-icon-*` class is silent
        without it. %>
    <%= stylesheet_link_tag 'dsfr.min' %>
    <%= stylesheet_link_tag 'utility/dsfr-utility.min' %>
    <%# Propshaft serves files as they are: one stylesheet per component is one
        `<link>` per component, and not an `@import` that would not reach the
        digested address. %>
    <%= stylesheet_link_tag 'application', 'card_component', 'country_tag_component', 'procedure_component',
          'search_field', 'entry_list' %>
  </head>

  <body>
    <%= dsfr_skiplink(label: t('layouts.application.skiplink'),
      links: [link_to(t('layouts.application.skiplink_content'), '#contenu')]) %>
    <%= render 'layouts/entete' %>

    <div class="fr-container fr-my-4w">
      <main id="contenu">
        <%= render 'layouts/messages' %>
        <%= yield %>
      </main>
    </div>

    <%= render 'layouts/pied_de_page' %>

    <%# No theme switcher is offered: `data-fr-scheme="system"` follows the one
        the system sets, with no JavaScript. That is what lets us leave out the
        inline script the DSFR otherwise uses against the flash of a wrong
        theme — and which a content security policy would have to allow. %>
    <%= javascript_include_tag 'dsfr.module.min', type: 'module' %>
    <%= javascript_include_tag 'dsfr.nomodule.min', nomodule: true %>
    <%= javascript_include_tag 'filter', defer: true %>
  </body>
</html>
