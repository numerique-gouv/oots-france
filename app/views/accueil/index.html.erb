<% content_for :title, t('layouts.application.name') %>
<% content_for :full_width, true %>

<div class="accueil-hero fr-background-alt--blue-france">
  <div class="fr-container fr-py-8w">
    <div class="fr-grid-row fr-grid-row--gutters fr-grid-row--middle">
      <div class="fr-col-12 fr-col-md-7">
        <h1><%= t('accueil.index.hero.title') %></h1>
        <p class="fr-text--lead"><%= t('accueil.index.hero.lead_html') %></p>
        <ul class="fr-btns-group fr-btns-group--inline-md fr-btns-group--icon-right fr-mb-0">
          <li>
            <a class="fr-btn fr-btn--icon-right fr-icon-arrow-down-line" href="#concerne"><%= t('accueil.index.hero.concerned') %></a>
          </li>
          <li>
            <a class="fr-btn fr-btn--secondary" href="#fonctionnement"><%= t('accueil.index.hero.how_it_works') %></a>
          </li>
        </ul>
      </div>
      <div class="fr-hidden fr-unhidden-md fr-col-md-5">
        <figure class="fr-m-0">
          <div class="accueil-hero__exchange">
            <div class="accueil-hero__party">
              <%= render PictogramComponent.new(name: 'buildings/city-hall') %>
              <p class="accueil-title fr-text--sm fr-text--bold fr-mb-0"><%= t('accueil.index.hero.french_administrations') %></p>
            </div>
            <div class="accueil-hero__arrows" aria-hidden="true">
              <span class="fr-icon-file-text-line"></span>
              <span class="fr-icon-arrow-left-right-line"></span>
            </div>
            <div class="accueil-hero__party">
              <%= render PictogramComponent.new(name: 'digital/internet') %>
              <p class="accueil-title fr-text--sm fr-text--bold fr-mb-0"><%= t('accueil.index.hero.other_administrations') %></p>
            </div>
          </div>
          <figcaption class="accueil-mention fr-text--xs fr-mt-2w"><%= t('accueil.index.hero.caption') %></figcaption>
        </figure>
      </div>
    </div>
  </div>
</div>

<section class="fr-py-7w" id="comprendre" aria-labelledby="titre-comprendre">
  <div class="fr-container">
    <h2 id="titre-comprendre"><%= t('accueil.index.in_brief.title') %></h2>
    <p class="accueil-measure fr-text--lg fr-mb-3w"><%= t('accueil.index.in_brief.intro_html') %></p>
    <ul class="fr-raw-list fr-grid-row fr-grid-row--gutters fr-mb-5w">
      <li class="fr-col-12 fr-col-md-4">
        <div class="accueil-box">
          <p class="accueil-title fr-text--bold fr-mb-1w"><%= t('accueil.index.in_brief.pillars.information.title') %></p>
          <p class="fr-text--sm fr-mb-0">
            <%= t('accueil.index.in_brief.pillars.information.body_html',
                  your_europe: new_window_link(t('accueil.index.in_brief.pillars.information.your_europe'),
                    'https://europa.eu/youreurope/')) %>
          </p>
        </div>
      </li>
      <li class="fr-col-12 fr-col-md-4">
        <div class="accueil-box accueil-box--highlighted">
          <p class="accueil-title accueil-title--blue fr-text--bold fr-mb-1w">
            <%= t('accueil.index.in_brief.pillars.procedures.title') %>
            <span class="fr-badge fr-badge--sm"><%= t('accueil.index.in_brief.pillars.procedures.badge') %></span>
          </p>
          <p class="fr-text--sm fr-mb-0"><%= t('accueil.index.in_brief.pillars.procedures.body') %></p>
        </div>
      </li>
      <li class="fr-col-12 fr-col-md-4">
        <div class="accueil-box">
          <p class="accueil-title fr-text--bold fr-mb-1w"><%= t('accueil.index.in_brief.pillars.assistance.title') %></p>
          <p class="fr-text--sm fr-mb-0"><%= t('accueil.index.in_brief.pillars.assistance.body') %></p>
        </div>
      </li>
    </ul>
    <div class="fr-grid-row fr-grid-row--gutters">
      <div class="accueil-principle fr-col-12 fr-col-md-6 fr-col-lg-3">
        <%= render PictogramComponent.new(name: 'institutions/justice') %>
        <h3 class="fr-h6 fr-mt-2w fr-mb-1w"><%= t('accueil.index.in_brief.principles.obligation.title') %></h3>
        <p class="fr-mb-0">
          <%= t('accueil.index.in_brief.principles.obligation.body_html',
                regulation: new_window_link(t('accueil.index.in_brief.principles.obligation.regulation'),
                  regulation_address)) %>
        </p>
      </div>
      <% { user_request: 'digital/avatar', reliable: 'document/document-signature', cross_border: 'map/map' }
           .each do |principle, pictogram| %>
        <div class="accueil-principle fr-col-12 fr-col-md-6 fr-col-lg-3">
          <%= render PictogramComponent.new(name: pictogram) %>
          <h3 class="fr-h6 fr-mt-2w fr-mb-1w"><%= t("accueil.index.in_brief.principles.#{principle}.title") %></h3>
          <p class="fr-mb-0"><%= t("accueil.index.in_brief.principles.#{principle}.body") %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<section class="fr-background-alt--grey fr-py-7w" id="fonctionnement" aria-labelledby="titre-fonctionnement">
  <div class="fr-container">
    <h2 id="titre-fonctionnement"><%= t('accueil.index.how_it_works.title') %></h2>
    <p class="accueil-measure fr-text--lg fr-mb-5w"><%= t('accueil.index.how_it_works.example') %></p>
    <ol class="fr-grid-row fr-grid-row--gutters fr-raw-list">
      <% %i[sign_in request lookup preview delivery].each.with_index(1) do |step, number| %>
        <li class="fr-col-12 fr-col-md-6 fr-col-lg">
          <div class="accueil-step">
            <span class="accueil-number accueil-number--large" aria-hidden="true"><%= number %></span>
            <h3 class="fr-h6 fr-mb-0"><%= t("accueil.index.how_it_works.steps.#{step}.title") %></h3>
            <p class="fr-text--sm fr-mb-0"><%= t("accueil.index.how_it_works.steps.#{step}.body") %></p>
          </div>
        </li>
      <% end %>
    </ol>

    <div class="fr-mt-7w">
      <h3 class="fr-h4"><%= t('accueil.index.how_it_works.roles.title') %></h3>
      <p class="accueil-measure fr-mb-2w"><%= t('accueil.index.how_it_works.roles.intro') %></p>
      <ul class="accueil-measure fr-mb-4w">
        <% t('accueil.index.how_it_works.roles.handled').each do |handled| %>
          <li><%= handled %></li>
        <% end %>
      </ul>
      <figure class="accueil-diagram fr-m-0 fr-p-2w fr-p-md-4w">
        <div class="accueil-diagram__grid">
          <p class="accueil-diagram__label accueil-diagram__label--france fr-text--bold fr-mb-0"><%= t('accueil.index.how_it_works.roles.diagram.in_france') %></p>
          <div class="accueil-diagram__party accueil-diagram__party--requester accueil-diagram__party--france-top">
            <p class="fr-text--lg fr-text--bold fr-mb-0"><%= t('accueil.index.how_it_works.roles.diagram.your_procedure') %></p>
            <p class="fr-text--sm fr-mb-0"><%= t('accueil.index.how_it_works.roles.diagram.requests_evidence') %></p>
          </div>
          <div class="accueil-diagram__party accueil-diagram__party--provider accueil-diagram__party--france-bottom">
            <p class="fr-text--lg fr-text--bold fr-mb-0"><%= t('accueil.index.how_it_works.roles.diagram.your_administration') %></p>
            <p class="fr-text--sm fr-mb-0"><%= t('accueil.index.how_it_works.roles.diagram.issues_evidence') %></p>
          </div>
          <% %w[france-top france-bottom].each do |position| %>
            <span class="accueil-diagram__arrow accueil-diagram__arrow--<%= position %> fr-hidden fr-unhidden-lg fr-icon-arrow-left-right-line" aria-hidden="true"></span>
          <% end %>
          <span class="accueil-diagram__arrow fr-hidden-lg fr-icon-arrow-left-right-line" aria-hidden="true"></span>
          <div class="accueil-diagram__hub accueil-diagram__hub--france">
            <p class="accueil-title fr-text--lg fr-text--bold fr-mb-0"><%= t('layouts.application.name') %></p>
            <p class="fr-text--sm fr-mb-0"><%= t('accueil.index.how_it_works.roles.diagram.national_point') %></p>
          </div>
          <span class="accueil-diagram__arrow accueil-diagram__arrow--between fr-icon-arrow-left-right-line" aria-hidden="true"></span>
          <div class="accueil-diagram__hub accueil-diagram__hub--network">
            <p class="accueil-title fr-text--lg fr-text--bold fr-mb-0"><%= t('accueil.index.how_it_works.roles.diagram.network') %></p>
            <p class="fr-text--sm fr-mb-0"><%= t('accueil.index.how_it_works.roles.diagram.network_detail') %></p>
          </div>
          <% %w[abroad-top abroad-bottom].each do |position| %>
            <span class="accueil-diagram__arrow accueil-diagram__arrow--<%= position %> fr-hidden fr-unhidden-lg fr-icon-arrow-left-right-line" aria-hidden="true"></span>
          <% end %>
          <span class="accueil-diagram__arrow fr-hidden-lg fr-icon-arrow-left-right-line" aria-hidden="true"></span>
          <p class="accueil-diagram__label accueil-diagram__label--abroad fr-text--bold fr-mb-0"><%= t('accueil.index.how_it_works.roles.diagram.other_member_states') %></p>
          <div class="accueil-diagram__party accueil-diagram__party--provider accueil-diagram__party--abroad-top">
            <p class="fr-text--lg fr-text--bold fr-mb-0"><%= t('accueil.index.how_it_works.roles.diagram.an_administration') %></p>
            <p class="fr-text--sm fr-mb-0"><%= t('accueil.index.how_it_works.roles.diagram.issues_the_evidence') %></p>
          </div>
          <div class="accueil-diagram__party accueil-diagram__party--requester accueil-diagram__party--abroad-bottom">
            <p class="fr-text--lg fr-text--bold fr-mb-0"><%= t('accueil.index.how_it_works.roles.diagram.an_online_procedure') %></p>
            <p class="fr-text--sm fr-mb-0"><%= t('accueil.index.how_it_works.roles.diagram.requests_evidence') %></p>
          </div>
        </div>
        <figcaption class="accueil-diagram__legend fr-mt-3w">
          <p class="fr-sr-only"><%= t('accueil.index.how_it_works.roles.diagram.description') %></p>
          <% { requester: :service_provider, provider: :data_provider }.each do |party, role| %>
            <p class="accueil-diagram__key fr-text--sm fr-mb-0">
              <span class="accueil-diagram__swatch accueil-diagram__party--<%= party %>" aria-hidden="true"></span>
              <%= t("accueil.index.how_it_works.roles.diagram.#{role}") %>
            </p>
          <% end %>
        </figcaption>
      </figure>
    </div>

    <div class="fr-mt-6w">
      <h3 class="fr-h4"><%= t('accueil.index.how_it_works.common_services.title') %></h3>
      <p class="accueil-measure fr-mb-3w"><%= t('accueil.index.how_it_works.common_services.intro_html') %></p>
      <ul class="fr-raw-list fr-grid-row fr-grid-row--gutters">
        <% %i[evidence_broker data_service_directory semantic_repository].each do |directory| %>
          <li class="fr-col-12 fr-col-md-4">
            <div class="accueil-box accueil-box--card">
              <p class="accueil-title fr-text--bold fr-mb-1w"><%= t("accueil.index.how_it_works.common_services.#{directory}.title") %></p>
              <p class="fr-text--sm fr-mb-1w"><%= t("accueil.index.how_it_works.common_services.#{directory}.body") %></p>
              <p class="accueil-mention fr-text--xs fr-mb-0"><span lang="en"><%= t("accueil.index.how_it_works.common_services.#{directory}.name") %></span></p>
            </div>
          </li>
        <% end %>
      </ul>
      <p class="accueil-measure fr-mt-3w fr-mb-0"><%= t('accueil.index.how_it_works.common_services.use') %></p>
      <p class="accueil-measure fr-mt-2w fr-mb-0"><%= t('accueil.index.how_it_works.common_services.check_html',
            link: link_to(t('accueil.index.how_it_works.common_services.check_link'), available_evidence_index_path)) %></p>
    </div>
  </div>
</section>

<section class="fr-py-7w" id="interet" aria-labelledby="titre-interet">
  <div class="fr-container">
    <h2 id="titre-interet" class="fr-mb-5w"><%= t('accueil.index.benefits.title') %></h2>
    <div class="fr-grid-row fr-grid-row--gutters">
      <% { reliable: 'fr-icon-file-text-line', open_to_europe: 'fr-icon-earth-line',
           single_connection: 'fr-icon-arrow-left-right-line', obligations: 'fr-icon-checkbox-circle-line' }
           .each do |benefit, icon| %>
        <div class="fr-col-12 fr-col-md-6 fr-col-lg-3">
          <span class="accueil-icon <%= icon %> fr-icon--lg" aria-hidden="true"></span>
          <h3 class="fr-h6 fr-mt-2w fr-mb-1w"><%= t("accueil.index.benefits.#{benefit}.title") %></h3>
          <p class="fr-mb-0"><%= t("accueil.index.benefits.#{benefit}.body") %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<section class="fr-background-alt--blue-france fr-py-7w" id="concerne" aria-labelledby="titre-concerne">
  <div class="fr-container">
    <h2 id="titre-concerne"><%= t('accueil.index.concerned.title') %></h2>
    <p class="accueil-measure fr-text--lg fr-mb-5w"><%= t('accueil.index.concerned.intro') %></p>
    <div class="fr-grid-row fr-grid-row--gutters">
      <div class="fr-col-12 fr-col-md-6">
        <div class="accueil-box accueil-box--role">
          <p class="fr-badge fr-badge--blue-ecume fr-mb-2w"><%= t('accueil.index.concerned.service_provider.badge') %></p>
          <h3 class="fr-h4 fr-mb-2w"><%= t('accueil.index.concerned.service_provider.title') %></h3>
          <p><%= t('accueil.index.concerned.service_provider.body') %></p>
          <p class="fr-text--bold fr-mb-1w"><%= t('accueil.index.concerned.conditions_intro') %></p>
          <ul class="fr-mb-3w">
            <li>
              <%= t('accueil.index.concerned.service_provider.annex_html',
                    annex: link_to(t('accueil.index.concerned.service_provider.annex'), '#demarches')) %>
            </li>
            <li><%= t('accueil.index.concerned.service_provider.directives_html', **directive_links) %></li>
          </ul>
          <p class="accueil-mention fr-text--sm"><%= t('accueil.index.concerned.service_provider.examples') %></p>
          <%= link_to t('accueil.index.concerned.service_provider.check'), available_evidence_index_path,
                class: 'fr-btn fr-btn--secondary' %>
        </div>
      </div>
      <div class="fr-col-12 fr-col-md-6">
        <div class="accueil-box accueil-box--role">
          <p class="fr-badge fr-badge--green-emeraude fr-mb-2w"><%= t('accueil.index.concerned.data_provider.badge') %></p>
          <h3 class="fr-h4 fr-mb-2w"><%= t('accueil.index.concerned.data_provider.title') %></h3>
          <p><%= t('accueil.index.concerned.data_provider.body') %></p>
          <p class="fr-text--bold fr-mb-1w"><%= t('accueil.index.concerned.conditions_intro') %></p>
          <ul class="fr-mb-3w">
            <% t('accueil.index.concerned.data_provider.conditions').each do |condition| %>
              <li><%= condition %></li>
            <% end %>
          </ul>
          <p class="accueil-mention fr-text--sm fr-mb-0"><%= t('accueil.index.concerned.data_provider.examples') %></p>
        </div>
      </div>
    </div>

    <section class="fr-mt-5w" id="demarches" aria-labelledby="titre-demarches">
      <h3 id="titre-demarches" class="fr-h4"><%= t('accueil.index.concerned.procedures.title') %></h3>
      <p class="accueil-measure fr-mb-3w"><%= t('accueil.index.concerned.procedures.intro') %></p>
      <div class="fr-grid-row fr-grid-row--gutters">
        <% [%i[birth residence studying working moving], %i[retiring business critical_raw_materials net_zero]]
             .each_with_index do |events, column| %>
          <div class="fr-col-12 fr-col-md-6">
            <div class="fr-accordions-group">
              <% events.each do |event| %>
                <section class="fr-accordion">
                  <h4 class="fr-accordion__title">
                    <button type="button" class="fr-accordion__btn" aria-expanded="false" aria-controls="procedures-<%= event %>">
                      <%= t("accueil.index.concerned.procedures.events.#{event}.title") %>
                    </button>
                  </h4>
                  <div class="fr-collapse" id="procedures-<%= event %>">
                    <ul class="fr-mb-0">
                      <% t("accueil.index.concerned.procedures.events.#{event}.procedures").each do |procedure| %>
                        <li><%= procedure %></li>
                      <% end %>
                    </ul>
                  </div>
                </section>
              <% end %>
              <% if column == 1 %>
                <section class="fr-accordion">
                  <h4 class="fr-accordion__title">
                    <button type="button" class="fr-accordion__btn" aria-expanded="false" aria-controls="procedures-directives">
                      <%= t('accueil.index.concerned.procedures.directives.title') %>
                    </button>
                  </h4>
                  <div class="fr-collapse" id="procedures-directives">
                    <ul class="fr-mb-0">
                      <li>
                        <%= t('accueil.index.concerned.procedures.directives.professional_qualifications_html',
                              directive: directive_link(:professional_qualifications)) %>
                      </li>
                      <li><%= t('accueil.index.concerned.procedures.directives.services_html', directive: directive_link(:services)) %></li>
                      <li>
                        <%= t('accueil.index.concerned.procedures.directives.public_procurement_html',
                              public_procurement: directive_link(:public_procurement,
                                t('accueil.index.concerned.procedures.directives.public_procurement')),
                              utilities: directive_link(:utilities, t('accueil.index.concerned.procedures.directives.utilities'))) %>
                      </li>
                    </ul>
                  </div>
                </section>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
      <p class="fr-text--sm fr-mt-3w fr-mb-0">
        <%= t('accueil.index.concerned.procedures.reference_html',
              annex: new_window_link(t('accueil.index.concerned.procedures.annex'), consolidated_regulation_address)) %>
      </p>
    </section>
  </div>
</section>

<section class="fr-py-7w" id="raccorder" aria-labelledby="titre-raccorder">
  <div class="fr-container">
    <h2 id="titre-raccorder"><%= t('accueil.index.connecting.title') %></h2>
    <p class="accueil-measure fr-text--lg fr-mb-5w"><%= t('accueil.index.connecting.intro') %></p>
    <div class="fr-grid-row fr-grid-row--gutters">
      <% { service_provider: ['fr-badge--blue-ecume', %i[list sign_in form request test]],
           data_provider: ['fr-badge--green-emeraude', %i[identify register api test]] }
           .each do |role, (badge, steps)| %>
        <div class="fr-col-12 fr-col-md-6">
          <p class="fr-badge <%= badge %> fr-mb-2w"><%= t("accueil.index.connecting.#{role}.badge") %></p>
          <h3 class="fr-h4"><%= t("accueil.index.connecting.#{role}.title") %></h3>
          <ol class="accueil-steps fr-raw-list">
            <% steps.each.with_index(1) do |step, number| %>
              <li>
                <span class="accueil-number" aria-hidden="true"><%= number %></span>
                <div>
                  <h4 class="fr-h6 fr-mb-1v"><%= t("accueil.index.connecting.#{role}.steps.#{step}.title") %></h4>
                  <% body = if step == :list
                              t('accueil.index.connecting.service_provider.steps.list.body_html',
                                countries: link_to(t('accueil.index.connecting.service_provider.steps.list.countries'),
                                  available_evidence_index_path))
                            else
                              t("accueil.index.connecting.#{role}.steps.#{step}.body")
                            end %>
                  <p class="fr-mb-0"><%= body %></p>
                </div>
              </li>
            <% end %>
          </ol>
        </div>
      <% end %>
    </div>

    <div class="accueil-handled fr-background-alt--blue-france fr-mt-5w">
      <h3 class="fr-h5"><%= t('accueil.index.connecting.handled.title') %></h3>
      <ul class="fr-raw-list fr-grid-row fr-grid-row--gutters">
        <% t('accueil.index.connecting.handled.items').each do |item| %>
          <li class="accueil-check fr-col-12 fr-col-md-6 fr-col-lg-4">
            <span class="accueil-icon fr-icon-check-line" aria-hidden="true"></span><span><%= item %></span>
          </li>
        <% end %>
      </ul>
      <ul class="fr-btns-group fr-btns-group--inline-md fr-btns-group--icon-left fr-mt-3w fr-mb-0">
        <li><%= new_window_link(t('accueil.index.documentation'), repository_address, class: 'fr-btn') %></li>
        <li>
          <%= link_to t('accueil.index.connecting.write'), team_mail_address,
                class: 'fr-btn fr-btn--secondary fr-btn--icon-left fr-icon-mail-line' %>
        </li>
      </ul>
    </div>
  </div>
</section>

<section class="fr-background-alt--grey fr-py-7w" id="etat" aria-labelledby="titre-etat">
  <div class="fr-container">
    <h2 id="titre-etat"><%= t('accueil.index.status.title') %></h2>
    <p class="accueil-measure fr-text--lg fr-mb-5w"><%= t('accueil.index.status.lead') %></p>
    <ol class="fr-raw-list fr-grid-row fr-grid-row--gutters">
      <% { done: 'fr-badge--success', ongoing: 'fr-badge--info', upcoming: nil }.each do |milestone, badge| %>
        <li class="fr-col-12 fr-col-md-4">
          <div class="accueil-milestone <%= 'accueil-milestone--upcoming' unless badge %>">
            <p class="fr-badge fr-badge--sm <%= badge %> fr-mb-1w"><%= t("accueil.index.status.milestones.#{milestone}.badge") %></p>
            <p class="accueil-milestone__date fr-text--sm fr-text--bold fr-mb-1v"><%= t("accueil.index.status.milestones.#{milestone}.date") %></p>
            <h3 class="fr-h6 fr-mb-1w"><%= t("accueil.index.status.milestones.#{milestone}.title") %></h3>
            <p class="fr-text--sm fr-mb-0"><%= t("accueil.index.status.milestones.#{milestone}.body") %></p>
          </div>
        </li>
      <% end %>
    </ol>
  </div>
</section>

<section class="fr-py-7w" id="faq" aria-labelledby="titre-faq">
  <div class="fr-container">
    <h2 id="titre-faq" class="fr-mb-4w"><%= t('accueil.index.faq.title') %></h2>
    <div class="accueil-faq fr-accordions-group">
      <% %i[mandatory domestic data paper governance users].each do |question| %>
        <section class="fr-accordion">
          <h3 class="fr-accordion__title">
            <button type="button" class="fr-accordion__btn" aria-expanded="false" aria-controls="faq-<%= question %>">
              <%= t("accueil.index.faq.#{question}.question") %>
            </button>
          </h3>
          <div class="fr-collapse" id="faq-<%= question %>">
            <p class="fr-mb-0">
              <% if question == :data %>
                <%= t('accueil.index.faq.data.answer', count: audit_trail_retention_months) %>
              <% else %>
                <%= t("accueil.index.faq.#{question}.answer") %>
              <% end %>
            </p>
          </div>
        </section>
      <% end %>
    </div>
  </div>
</section>

<section class="fr-background-alt--blue-france fr-py-7w" id="contact" aria-labelledby="titre-contact">
