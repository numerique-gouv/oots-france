<ul class="entry-list entry-list--clickable">
  <% lists.each do |list| %>
    <%# Deux combinaisons sont des alternatives, et les types de l'une sont
        exigés ensemble : le mot ne se dit que là où il tranche quelque chose,
        c'est-à-dire quand ce pays en publie plusieurs. %>
    <% if lists.size > 1 %>
      <li class="entry__group">
        Combinaison <strong><%= list.label || list.id %></strong>, exigée d'un bloc
      </li>
    <% end %>

    <% list.evidence_types.each do |type| %>
      <li class="entry <%= 'entry--grouped' if lists.size > 1 %>">
        <span class="entry__name"><%= type.display_name %></span>
        <code class="entry__tag"><%= type.distribution_format %></code>
        <%# La flèche dans un `span` plutôt que par `fr-link--icon-right` : cette
            classe peint l'icône dans les pseudo-éléments du lien, dont la
            feuille de style a besoin pour l'étendre à la ligne. %>
        <%= link_to admin_common_services_requirement_evidence_type_providers_path(
              requirement.uuid, type.uuid,
            ), class: 'entry__action fr-link' do %>
          Voir les fournisseurs<span class="fr-icon-arrow-right-line fr-ml-1w" aria-hidden="true"></span>
        <% end %>
      </li>
    <% end %>
  <% end %>
</ul>
