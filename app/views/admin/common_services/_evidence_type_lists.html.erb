<ul class="entry-list entry-list--clickable">
  <% lists.each do |list| %>
    <%# Two combinations are alternatives, and the evidence types within one
        are required together: the word is said only where it settles
        something, which is when this country publishes more than one. %>
    <% if lists.size > 1 %>
      <li class="entry__group">
        <%= t('admin.common_services.evidence_type_lists.combination_html', label: list.label || list.id) %>
      </li>
    <% end %>

    <% if list.no_match? %>
      <%= render 'admin/common_services/no_match', list:, grouped: lists.size > 1 %>
    <% end %>

    <% list.evidence_types.each do |type| %>
      <li class="entry <%= 'entry--grouped' if lists.size > 1 %>">
        <span class="entry__name"><%= type.display_name %></span>
        <code class="entry__tag"><%= type.distribution_format %></code>
        <%# The arrow in a `span` rather than through `fr-link--icon-right`:
            that class paints the icon into the link's pseudo-elements, which
            the stylesheet needs in order to stretch it across the row. %>
        <%= link_to admin_common_services_requirement_evidence_type_providers_path(
              requirement.uuid, type.uuid,
            ), class: 'entry__action fr-link' do %>
          <%= t('admin.common_services.evidence_type_lists.see_providers') %><span class="fr-icon-arrow-right-line fr-ml-1w" aria-hidden="true"></span>
        <% end %>
      </li>
    <% end %>
  <% end %>
</ul>
