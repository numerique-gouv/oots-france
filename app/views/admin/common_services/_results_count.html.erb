<%# The tally the search field rewrites: `data-tally` hands it the plural
    forms, which the browser does not have. %>
<p class="fr-text--sm fr-mb-2w" id="<%= id %>" aria-live="polite"
  data-tally="<%= tally_forms('admin.common_services.results.count') %>">
  <%= t('admin.common_services.results.count', count:) %>
</p>
