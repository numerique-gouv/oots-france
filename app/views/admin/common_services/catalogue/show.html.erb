<% content_for :title, t('components.directory_breadcrumbs.directories') %>

<%= render DirectoryBreadcrumbsComponent.new %>

<div class="fr-grid-row fr-grid-row--top fr-mb-2w">
  <div class="fr-col-12 fr-col-md">
    <h1><%= t('components.directory_breadcrumbs.directories') %></h1>
  </div>
  <div class="fr-mt-md-1w fr-ml-md-1w">
    <%= link_to t('admin.common_services.resolutions.show.title'), admin_common_services_resolution_path,
          class: 'fr-btn fr-btn--secondary fr-btn--icon-right fr-icon-arrow-right-line' %>
  </div>
</div>

<p class="fr-text--lead fr-col-12 fr-col-md-8"><%= t('admin.common_services.catalogue.show.lead') %></p>

<div class="fr-grid-row fr-grid-row--gutters fr-mb-4w">
  <div class="fr-col-12 fr-col-md-4">
    <%= dsfr_tile(
          title: t('admin.common_services.countries.index.title'),
          url: admin_common_services_countries_path,
          description: t('admin.common_services.catalogue.show.tiles.countries', count: @countries.size),
        ) %>
  </div>
  <div class="fr-col-12 fr-col-md-4">
    <%= dsfr_tile(
          title: t('admin.common_services.procedures.index.title'),
          url: admin_common_services_procedures_path,
          description: t('admin.common_services.catalogue.show.tiles.procedures', count: @procedures.size,
            # The tally is written to be read on its own, hence capitalised:
            # stitched into the middle of a sentence, it would carry its
            # capital in.
            countries: t('admin.common_services.countries.count', count: @countries.size).downcase),
        ) %>
  </div>
  <div class="fr-col-12 fr-col-md-4">
    <%= dsfr_tile(
          title: t('admin.common_services.requirements.index.title'),
          url: admin_common_services_requirements_path,
          description: t('admin.common_services.catalogue.show.tiles.requirements', count: @requirements.size),
        ) %>
  </div>
</div>

<%# The Data Service Directory takes no query without an evidence type and a
    country: its providers are not listed, they are asked for. %>
<%= dsfr_callout(title: t('admin.common_services.catalogue.show.providers.title')) do %>
  <%= t('admin.common_services.catalogue.show.providers.body') %>
<% end %>

<%= render DirectoryQueryComponent.new(query_id: EvidenceBrokerClient::REQUIREMENTS_QUERY) %>
