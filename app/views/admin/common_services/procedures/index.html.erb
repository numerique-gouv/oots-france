<% content_for :title, t('admin.common_services.procedures.index.title') %>

<%= render DirectoryBreadcrumbsComponent.new(trail: [[t('admin.common_services.procedures.index.title'), nil]]) %>

<h1><%= t('admin.common_services.procedures.index.title') %></h1>

<p class="fr-col-12 fr-col-md-8"><%= t('admin.common_services.procedures.index.lead') %></p>

<%= render SearchFieldComponent.new(
      label: t('admin.common_services.procedures.index.search'),
      id: 'recherche-demarche',
      entries: '#liste-demarches > *',
      tally: '#decompte-demarches',
      empty: '#aucune-demarche',
    ) %>

<%= render 'admin/common_services/results_count', id: 'decompte-demarches', count: @procedures.size %>

<%# The code and its wording make one title: the code alone says nothing, and
    the wording alone appears in no query. The test procedure « 00 » is in no
    code list — it belongs to the test environments — and so shows bare. %>
<div id="liste-demarches">
  <% @procedures.each do |procedure| %>
    <div>
      <%= render CardComponent.new(
            title: named_procedure(procedure.code),
            hint: procedure_hint(procedure.code),
            href: admin_common_services_procedure_path(procedure.code),
            dense: true, clickable: true,
          ) do |carte| %>
        <% carte.with_list do %>
          <%= render CountryTagListComponent.new(
                caption: t('admin.common_services.procedures.index.declared_by'),
                codes: procedure.countries, names: country_names,
                link: ->(code) { admin_common_services_procedure_country_path(procedure.code, code) },
              ) %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>

<p id="aucune-demarche" <%= 'hidden' if @procedures.any? %>><%= t('admin.common_services.procedures.index.empty') %></p>

<%= render DirectoryQueryComponent.new(query_id: EvidenceBrokerClient::REQUIREMENTS_QUERY) %>
