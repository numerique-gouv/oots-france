<h1 class="fr-h3"><%= full_named_procedure(@procedure.code) %></h1>

<p class="fr-text--lead"><%= t('admin.common_services.declarations.role_html',
      country: named_country(@country)) %></p>

<p><%= declaration_summary(
      labels: @requirements.values.flatten.filter_map(&:label),
      country: @country,
      requirements: @requirements.size,
    ) %>.</p>

<p><%= t('admin.common_services.declarations.lead_html') %></p>

<%# Une carte par exigence : ce pays peut la déclarer plusieurs fois, sous des
    intitulés différents, sans qu'elle demande pour autant deux choses. %>
<% @requirements.each do |_, declared| %>
  <% exigence = declared.first.requirement %>
  <%= render CardComponent.new(
        title: exigence&.display_name || t('admin.common_services.declarations.no_requirement'),
        href: (admin_common_services_requirement_path(exigence.uuid) if exigence),
        clickable: true,
      ) do %>
    <%= exigence&.detail || t('admin.common_services.declarations.no_detail') %>
  <% end %>
<% end %>

<% if @requirements.empty? %>
  <p><%= t('admin.common_services.declarations.empty') %></p>
<% end %>

<%= render DirectoryQueryComponent.new(query_id: EvidenceBrokerClient::REQUIREMENTS_QUERY) %>
