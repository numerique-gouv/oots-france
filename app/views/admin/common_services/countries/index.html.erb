<% content_for :title, 'Pays' %>

<%= render DirectoryBreadcrumbsComponent.new(trail: [['Pays', nil]]) %>

<h1>Pays</h1>

<p>
  Les États membres qui ont publié au moins une déclaration à l'Evidence
  Broker. Un pays absent d'ici n'a rien déclaré, ce qui n'est pas la même chose
  que ne pas être inscrit au Data Service Directory.
</p>

<%= dsfr_callout(title: 'Requêteur ou fournisseur ?') do %>
  Un pays tient deux rôles, et l'annuaire ne répond pas la même chose selon
  celui qu'on lui demande. <strong>Requêteur</strong>, il déclare ses démarches
  et ce qu'elles exigent de prouver : c'est ce que ces pages montrent.
  <strong>Fournisseur</strong>, il délivre les justificatifs qui satisfont une
  exigence — la sienne ou celle d'un autre —, et cela se lit sous l'exigence.
<% end %>

<%= render SearchFieldComponent.new(
      label: 'Rechercher un pays, son code',
      id: 'recherche-pays',
      entries: '#liste-pays > *',
      tally: '#decompte-pays',
      empty: '#aucun-pays',
    ) %>

<%= render 'admin/common_services/results_count', id: 'decompte-pays', count: @procedures.size %>

<%# Les deux rôles, un lien chacun : c'est ici qu'ils se séparent, et le
    décompte n'existe que du côté requêteur — l'Evidence Broker n'a pas de
    requête qui parte d'un pays fournisseur. %>
<div id="liste-pays">
<% @procedures.each do |code, procedures| %>
  <div>
  <%= render CardComponent.new(title: named_country(code), dense: true) do |carte| %>
    <% carte.with_list do %>
      <ul class="entry-list entry-list--clickable">
        <li class="entry">
          <span class="entry__name">
            En <strong>requêteur</strong> —
            <%= t('admin.common_services.procedures.count', count: procedures.size) %> déclarées
          </span>
          <%= link_to admin_common_services_country_procedures_path(code), class: 'entry__action fr-link' do %>
            Voir ses démarches<span class="fr-icon-arrow-right-line fr-ml-1w" aria-hidden="true"></span>
          <% end %>
        </li>

        <li class="entry">
          <span class="entry__name">En <strong>fournisseur</strong></span>
          <%= link_to admin_common_services_country_requirements_path(code), class: 'entry__action fr-link' do %>
            Voir ses justificatifs<span class="fr-icon-arrow-right-line fr-ml-1w" aria-hidden="true"></span>
          <% end %>
        </li>
      </ul>
    <% end %>
  <% end %>
  </div>
<% end %>
</div>

<p id="aucun-pays" <%= 'hidden' if @procedures.any? %>>Aucun pays ne correspond à cette recherche.</p>

<%= render DirectoryQueryComponent.new(query_id: EvidenceBrokerClient::REQUIREMENTS_QUERY) %>
