<% content_for :title, t('admin.common_services.countries.index.title') %>

<%= render DirectoryBreadcrumbsComponent.new(trail: [[t('admin.common_services.countries.index.title'), nil]]) %>

<h1><%= t('admin.common_services.countries.index.title') %></h1>

<p class="fr-col-12 fr-col-md-8"><%= t('admin.common_services.countries.index.lead') %></p>

<%= dsfr_callout(title: t('admin.common_services.countries.index.roles.title')) do %>
  <%= t('admin.common_services.countries.index.roles.body_html') %>
<% end %>

<%= render SearchFieldComponent.new(
      label: t('admin.common_services.countries.index.search'),
      id: 'recherche-pays',
      entries: '#liste-pays > *',
      tally: '#decompte-pays',
      empty: '#aucun-pays',
    ) %>

<%= render 'admin/common_services/results_count', id: 'decompte-pays', count: @procedures.size %>

<%# The two roles, one link each: this is where they part, and the tally
    exists on the requesting side alone — the Evidence Broker has no query that
    starts from a providing country. %>
<div id="liste-pays">
<% @procedures.each do |code, procedures| %>
  <div>
  <%= render CardComponent.new(title: named_country(code), dense: true) do |carte| %>
    <% carte.with_list do %>
      <ul class="entry-list entry-list--clickable">
        <li class="entry">
          <span class="entry__name">
            <%= t('admin.common_services.countries.index.roles.requester_html',
                  procedures: t('admin.common_services.countries.index.declared_procedures',
                    count: procedures.size)) %>
          </span>
          <%= link_to admin_common_services_country_procedures_path(code), class: 'entry__action fr-link' do %>
            <%= t('admin.common_services.countries.index.see_procedures') %><span class="fr-icon-arrow-right-line fr-ml-1w" aria-hidden="true"></span>
          <% end %>
        </li>

        <li class="entry">
          <span class="entry__name"><%= t('admin.common_services.countries.index.roles.provider_html') %></span>
          <%= link_to admin_common_services_country_requirements_path(code), class: 'entry__action fr-link' do %>
            <%= t('admin.common_services.countries.index.see_evidence') %><span class="fr-icon-arrow-right-line fr-ml-1w" aria-hidden="true"></span>
          <% end %>
        </li>
      </ul>
    <% end %>
  <% end %>
  </div>
<% end %>
</div>

<p id="aucun-pays" <%= 'hidden' if @procedures.any? %>><%= t('admin.common_services.countries.index.empty') %></p>

<%= render DirectoryQueryComponent.new(query_id: EvidenceBrokerClient::REQUIREMENTS_QUERY) %>
