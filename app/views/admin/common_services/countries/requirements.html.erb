<% content_for :title, t('admin.common_services.countries.requirements.title',
      country: named_country(@country)) %>

<%= render DirectoryBreadcrumbsComponent.new(trail: [
      [t('admin.common_services.countries.index.title'), admin_common_services_countries_path],
      [named_country(@country), nil],
      [t('admin.common_services.countries.requirements.crumb'), nil],
    ]) %>

<h1 class="fr-h3"><%= t('admin.common_services.countries.requirements.title',
      country: named_country(@country)) %></h1>

<p class="fr-col-12 fr-col-md-8"><%= t('admin.common_services.countries.requirements.lead_html') %></p>

<%= render DeferredContentComponent.new(
      url: admin_common_services_country_requirements_path(@country, listing: 1),
      message: t('admin.common_services.countries.requirements.loading'),
    ) %>
