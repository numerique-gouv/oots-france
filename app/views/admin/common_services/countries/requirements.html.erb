<% content_for :title, t('admin.common_services.countries.requirements.title',
      country: named_country(@country)) %>

<%= render DirectoryBreadcrumbsComponent.new(trail: [
      [t('admin.common_services.countries.index.title'), admin_common_services_countries_path],
      [named_country(@country), nil],
      [t('admin.common_services.countries.requirements.crumb'), nil],
    ]) %>

<h1 class="fr-h3"><%= t('admin.common_services.countries.requirements.title',
      country: named_country(@country)) %></h1>

<p class="fr-col-12 fr-col-md-8"><%= t('admin.common_services.countries.requirements.lead_html') %></p>

<%= render SearchFieldComponent.new(
      label: t('admin.common_services.countries.requirements.search'),
      id: 'recherche-exigence-fournie',
      entries: '#exigences-satisfaites > *',
      tally: '#decompte-exigences-satisfaites',
      empty: '#aucune-exigence-satisfaite',
    ) %>

<%= render 'admin/common_services/results_count', id: 'decompte-exigences-satisfaites', count: @published.size %>

<div id="exigences-satisfaites">
  <% @published.each do |requirement, lists| %>
    <div>
      <%= render CardComponent.new(title: requirement.display_name, heading_level: 2) do |carte| %>
        <%= t('admin.common_services.countries.requirements.card', country: in_country(@country)) %>

        <% carte.with_list do %>
          <%= render 'admin/common_services/evidence_type_lists', lists:, requirement: %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>

<p id="aucune-exigence-satisfaite" <%= 'hidden' if @published.any? %>>
  <%= t('admin.common_services.requirements.empty') %>
</p>

<%# Une requête par exigence : l'Evidence Broker n'en a pas qui parte du pays. %>
<%= render DirectoryQueryComponent.new(
      query_id: EvidenceBrokerClient::EVIDENCE_TYPES_QUERY,
      parameters: { 'requirement-id' =>
        t('admin.common_services.countries.requirements.swept', count: @swept.size) },
    ) %>
