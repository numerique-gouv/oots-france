<% content_for :title, t('components.directory_breadcrumbs.directories') %>

<%= render DirectoryBreadcrumbsComponent.new %>

<h1 class="fr-h3"><%= t('components.directory_breadcrumbs.directories') %></h1>

<%# A named refusal is an answer: the directory understood the question and
    says it holds nothing. An outage is not one, and the two are not read the
    same way. %>
<%= dsfr_alert(type: @error.code.present? ? :warning : :error,
      title: @error.code.presence || t('admin.common_services.refus.unreachable')) do %>
  <%= @error.message %>
<% end %>
