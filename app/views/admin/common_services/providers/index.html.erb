<% content_for :title, t('admin.common_services.providers.index.title',
      evidence_type: @evidence_type.display_name) %>

<%= render DirectoryBreadcrumbsComponent.new(trail: [
      [t('admin.common_services.requirements.index.title'), admin_common_services_requirements_path],
      [requirement.display_name, admin_common_services_requirement_path(requirement.uuid)],
      [named_country(@country), nil],
    ]) %>

<h1 class="fr-h3"><%= t('admin.common_services.providers.index.heading',
      evidence_type: @evidence_type.display_name, country: in_country(@country)) %></h1>

<p class="fr-text--lead fr-col-12 fr-col-md-8"><%= t('admin.common_services.providers.index.lead') %></p>

<%# Le pays ne se choisit pas : ce type de justificatif est publié par lui, et
    le demander à un autre ne peut que revenir vide. %>
<% if @refusal %>
  <%= dsfr_alert(type: :warning, title: @refusal.code) do %>
    <%= @refusal.message %>
  <% end %>
<% else %>
  <% @data_services.each do |service| %>
    <%= render CardComponent.new(title: service.label || t('admin.common_services.providers.index.data_service'), dense: true) do |carte| %>
      <code class="entry__tag"><%= service.distribution_format || '—' %></code>
      <%= t('admin.common_services.providers.index.level_of_assurance_html',
            level: service.level_of_assurance || '—') %>

      <%# L'identifiant que le DSD attribue au couple type et pays : c'est lui
          qu'une requête émise écrit dans son `DataServiceEvidenceType`, d'où sa
          place sur la carte plutôt que dans le repli technique. %>
      <br><span class="fr-text--sm"><%= t('admin.common_services.providers.index.service_id_html',
            id: service.id || '—') %></span>

      <% carte.with_list do %>
        <ul class="entry-list">
          <%# Un fournisseur et son point d'accès sont deux organisations : le
              premier détient le justificatif, le second achemine le message qui
              le demande, et une requête réelle adresse le second. %>
          <% service.providers.each do |provider| %>
            <li class="entry">
              <span class="entry__name"><%= provider.label || '—' %></span>
              <%= render CountryTagComponent.new(code: provider.address.country,
                    name: country_names[provider.address.country]) %>

              <span class="entry__detail">
                <code><%= provider.identifier.id %></code> · <%= provider.identifier.type_id %>
                <% if provider.address.postal_lines.any? %>
                  <br><%= provider.address.postal_lines.join(', ') %>
                <% end %>
              </span>

              <span class="entry__detail">
                <%= t('admin.common_services.providers.index.access_point_html',
                      label: provider.access_point.label || '—', id: provider.access_point.id,
                      versions: provider.access_point.conforms_to.join(', ').presence || '—') %>
              </span>
            </li>
          <% end %>
        </ul>
      <% end %>
    <% end %>
  <% end %>

  <% if @data_services.empty? %>
    <p><%= t('admin.common_services.providers.index.empty') %></p>
  <% end %>
<% end %>

<%# La console interroge le DSD exactement comme l'application : un service
    conforme à une autre version d'EDM ne revient donc pas dans cette réponse,
    et l'absence ne veut pas dire qu'il n'existe pas. %>
<%= render DirectoryQueryComponent.new(
      query_id: DataServiceDirectoryClient::DATA_SERVICES_QUERY,
      identifiers: { requirement: requirement.id, evidence_type: @evidence_type.id },
      parameters: {
        'evidence-type-classification' => @evidence_type.id,
        'country-code' => @country,
        'specification' => EdmSpecification::IDENTIFIER,
      },
    ) %>
