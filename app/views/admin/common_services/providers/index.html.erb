<% content_for :title, t('admin.common_services.providers.index.title',
      evidence_type: @evidence_type.display_name) %>

<%= render DirectoryBreadcrumbsComponent.new(trail: [
      [t('admin.common_services.requirements.index.title'), admin_common_services_requirements_path],
      [requirement.display_name, admin_common_services_requirement_path(requirement.uuid)],
      [named_country(@country), nil],
    ]) %>

<h1 class="fr-h3"><%= t('admin.common_services.providers.index.heading',
      evidence_type: @evidence_type.display_name, country: in_country(@country)) %></h1>

<p class="fr-text--lead fr-col-12 fr-col-md-8"><%= t('admin.common_services.providers.index.lead') %></p>

<%# The country is not chosen: this evidence type is published by it, and
    asking another can only come back empty. %>
<% if @refusal %>
  <%= dsfr_alert(type: :warning, title: @refusal.code) do %>
    <%= @refusal.message %>
  <% end %>
<% else %>
  <% @data_services.each do |service| %>
    <%= render CardComponent.new(title: service.label.presence || t('admin.common_services.providers.index.data_service'), dense: true) do |carte| %>
      <%# R-DSD-RESP-S027 makes `sdg:DistributedAs` mandatory: a service
          published without one is an anomaly of the directory, which the dash
          of an empty format would render as an ordinary gap. A badge on the
          card and not an alert in the page head, which would not say which of
          the services it speaks of. %>
      <% if service.distribution_published %>
        <code class="entry__tag"><%= service.distribution_format.presence || '—' %></code>
      <% else %>
        <span class="fr-badge fr-badge--sm fr-badge--warning"><%=
              t('admin.common_services.providers.index.no_distribution') %></span>
      <% end %>
      <%= t('admin.common_services.providers.index.level_of_assurance_html',
            level: service.level_of_assurance.presence || '—') %>

      <% unless service.distribution_published %>
        <br><span class="fr-text--sm"><%=
              t('admin.common_services.providers.index.no_distribution_detail_html',
                rule: render(TddRuleComponent.new(rule: DataService::DISTRIBUTION_RULE))) %></span>
      <% end %>

      <%# The identifier the Data Service Directory assigns to the evidence
          type and country pair: it is what an outgoing request writes into its
          `DataServiceEvidenceType`, hence its place on the card rather than in
          the technical fold. %>
      <br><span class="fr-text--sm"><%= t('admin.common_services.providers.index.service_id_html',
            id: service.id.presence || '—') %></span>

      <%# The data model of the distribution, which R-DSD-RESP-C010 has the
          directory publish as a Semantic Repository URL. Rendered only beside a
          structured format, R-DSD-RESP-C067 forbidding the value on the others:
          an empty line there would announce a gap the rule itself creates. It
          is not what the access point declares below — those are the EDM
          versions of R-DSD-RESP-C015, another element under another parent.

          Its absence is two states and not one, which a dash renders alike:
          C039 and C041 excuse a structured distribution the record also
          publishes in an unstructured format, and hold the directory at fault
          when it does not. %>
      <% if service.structured_distribution? %>
        <br>
        <% if service.distribution_conforms_to.present? %>
          <span class="fr-text--sm"><%= t('admin.common_services.providers.index.data_model_html',
                model: service.distribution_conforms_to) %></span>
        <% elsif service.data_model_required? %>
          <span class="fr-badge fr-badge--sm fr-badge--warning"><%=
                t('admin.common_services.providers.index.data_model_missing') %></span>
          <span class="fr-text--sm"><%= t('admin.common_services.providers.index.data_model_missing_detail_html',
                rule: render(TddRuleComponent.new(rule: service.data_model_rule))) %></span>
        <% else %>
          <span class="fr-text--sm"><%= t('admin.common_services.providers.index.data_model_waived_html',
                rule: render(TddRuleComponent.new(rule: service.data_model_rule))) %></span>
        <% end %>
      <% end %>

      <% carte.with_list do %>
        <ul class="entry-list">
          <%# An evidence provider and its access point are two organisations:
              the first holds the evidence, the second carries the message that
              asks for it, and a real request addresses the second. %>
          <% service.providers.each do |provider| %>
            <li class="entry">
              <span class="entry__name"><%= provider.label.presence || '—' %></span>
              <%= render CountryTagComponent.new(code: provider.address.country,
                    name: country_names[provider.address.country]) %>

              <span class="entry__detail">
                <code><%= provider.identifier.id %></code> · <%= provider.identifier.type_id %>
                <% if provider.address.postal_lines.any? %>
                  <br><%= provider.address.postal_lines.join(', ') %>
                <% end %>
              </span>

              <span class="entry__detail">
                <%= t('admin.common_services.providers.index.access_point_html',
                      label: provider.access_point.label.presence || '—', id: provider.access_point.id,
                      versions: provider.access_point.conforms_to.join(', ').presence || '—') %>
              </span>
            </li>
          <% end %>
        </ul>
      <% end %>
    <% end %>
  <% end %>

  <% if @data_services.empty? %>
    <p><%= t('admin.common_services.providers.index.empty') %></p>
  <% end %>
<% end %>

<%# The console queries the Data Service Directory exactly as the application
    does: a data service conforming to another EDM version therefore does not
    come back in this response, and absence does not mean it does not exist. %>
<%= render DirectoryQueryComponent.new(
      query_id: DataServiceDirectoryClient::DATA_SERVICES_QUERY,
      identifiers: { requirement: requirement.id, evidence_type: @evidence_type.id },
      parameters: {
        'evidence-type-classification' => @evidence_type.id,
        'country-code' => @country,
        'specification' => EdmSpecification::IDENTIFIER,
      },
    ) %>
