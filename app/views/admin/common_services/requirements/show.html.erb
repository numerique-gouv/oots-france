<% content_for :title, @requirement.label || t('admin.common_services.requirements.show.title') %>

<%= render DirectoryBreadcrumbsComponent.new(trail: [
      [t('admin.common_services.requirements.index.title'), admin_common_services_requirements_path],
      [@requirement.display_name, nil],
    ]) %>

<div class="fr-grid-row fr-grid-row--top fr-mb-2w">
  <div class="fr-col-12 fr-col-md">
    <h1><%= @requirement.display_name %></h1>
  </div>
  <div class="fr-mt-md-1w fr-ml-md-1w">
    <%= link_to t('admin.common_services.requirements.show.see_procedures'),
          admin_common_services_requirement_procedures_path(@requirement.uuid),
          class: 'fr-btn fr-btn--secondary fr-btn--icon-right fr-icon-arrow-right-line' %>
  </div>
</div>

<% if @requirement.detail.present? %>
  <p class="fr-col-12 fr-col-md-8"><em><%= @requirement.detail %></em></p>
<% end %>

<h2 class="fr-h5 fr-mt-6w"><%= t('admin.common_services.requirements.show.by_country') %></h2>

<%# This is the very principle of OOTS, and why this list is not bounded to the
    country that imposes the requirement: the evidence comes from the country
    that holds it, which is almost never the one where the procedure is carried
    out. %>
<p class="fr-col-12 fr-col-md-8"><%= t('admin.common_services.requirements.show.lead_html') %></p>

<%= render SearchFieldComponent.new(
      label: t('admin.common_services.requirements.show.search'),
      id: 'recherche-fournisseur',
      entries: '#par-pays-fournisseur > *',
      tally: '#decompte-types',
      empty: '#aucun-type',
    ) %>

<%= render 'admin/common_services/results_count', id: 'decompte-types', count: @types_count %>

<div id="par-pays-fournisseur">
<% @by_country.each do |country, lists, weight| %>
  <%# The weight of a card is what the tally adds up: a country counts for the
      evidence types it publishes, not for one. The controller works it out
      once and passes it in, rather than this card counting again. %>
  <div data-tally-weight="<%= weight %>">
  <%= render CardComponent.new(title: named_country(country), heading_level: 3, dense: true) do |carte| %>
    <%# The page title is far above once one has scrolled past twenty cards:
        each says again which requirement it speaks of. %>
    <%= t('admin.common_services.requirements.show.card_html',
          requirement: @requirement.display_name, country: in_country(country)) %>

    <% carte.with_list do %>
      <%= render 'admin/common_services/evidence_type_lists', lists:, requirement: @requirement %>
    <% end %>
  <% end %>
  </div>
<% end %>
</div>

<p id="aucun-type" <%= 'hidden' if @by_country.any? %>><%= t('admin.common_services.requirements.show.empty') %></p>

<%# The identifier is a Semantic Repository address, chosen elsewhere: it is
    read, not followed — the same rule as for an exchange's preview
    space. %>
<%= render DirectoryQueryComponent.new(
      query_id: EvidenceBrokerClient::EVIDENCE_TYPES_QUERY,
      identifiers: { requirement: @requirement.id },
      parameters: { 'requirement-id' => @requirement.id },
    ) %>
