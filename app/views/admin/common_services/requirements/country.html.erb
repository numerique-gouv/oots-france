<% content_for :title, t('admin.common_services.requirements.country.title',
      country: named_country(@country), requirement: @requirement.display_name) %>

<%= render DirectoryBreadcrumbsComponent.new(trail: [
      [t('admin.common_services.requirements.index.title'), admin_common_services_requirements_path],
      [@requirement.display_name, admin_common_services_requirement_path(@requirement.uuid)],
      [named_country(@country), nil],
    ]) %>

<h1 class="fr-h3"><%= t('admin.common_services.requirements.country.heading',
      country: in_country(@country), requirement: @requirement.display_name) %></h1>

<p class="fr-col-12 fr-col-md-8"><%= t('admin.common_services.requirements.country.lead_html') %></p>

<%# Not the tally of the page above: nothing narrows this one, so the count is
    written once and never rewritten. %>
<p class="fr-text--sm fr-mb-2w"><%= t('admin.common_services.results.count', count: @types_count) %></p>

<%= render CardComponent.new(title: named_country(@country), dense: true) do |carte| %>
  <% carte.with_list do %>
    <%= render 'admin/common_services/evidence_type_lists', lists: @lists, requirement: @requirement %>
  <% end %>
<% end %>

<%= render DirectoryQueryComponent.new(
      query_id: EvidenceBrokerClient::EVIDENCE_TYPES_QUERY,
      identifiers: { requirement: @requirement.id },
      parameters: { 'requirement-id' => @requirement.id },
    ) %>
