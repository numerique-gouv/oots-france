<% content_for :title, "Démarches — #{@requirement.display_name}" %>

<%= render DirectoryBreadcrumbsComponent.new(trail: [
      ['Exigences', admin_common_services_requirements_path],
      [@requirement.display_name, admin_common_services_requirement_path(@requirement.uuid)],
      ['Démarches qui l’exigent', nil],
    ]) %>

<h1 class="fr-h3">Démarches qui exigent « <%= @requirement.display_name %> »</h1>

<p>Les démarches qui reposent sur cette exigence, et les pays <strong>requêteurs</strong> qui les déclarent.</p>

<%# Une carte par démarche et non par déclaration : une même exigence est
    déclarée sous un même code par des dizaines de pays. %>
<% @requirement.reference_frameworks.group_by(&:procedure_code).each do |code, declared| %>
  <% published = declared.any? { |one| one.country.present? } %>
  <%= render CardComponent.new(
        title: named_procedure(code),
        hint: procedure_hint(code),
        href: (admin_common_services_procedure_path(code) if code.present?),
        dense: published, clickable: true,
      ) do |carte| %>
    <% if published %>
      <% carte.with_list do %>
        <%= render CountryTagListComponent.new(
              caption: 'Exigence déclarée par',
              codes: declared.map(&:country), names: country_names,
              link: ->(one) { admin_common_services_procedure_country_path(code, one) if code.present? },
            ) %>
      <% end %>
    <% else %>
      Aucun pays publié pour cette déclaration.
    <% end %>
  <% end %>
<% end %>

<%= render DirectoryQueryComponent.new(
      query_id: EvidenceBrokerClient::REQUIREMENTS_QUERY,
      identifiers: { 'Exigence' => @requirement.id },
    ) %>
