<% content_for :title, t('admin.journal.exchanges.index.title') %>

<%= render JournalBreadcrumbsComponent.new(
      trail: [[t('admin.journal.exchanges.index.title'), nil]],
    ) %>

<h1><%= t('admin.journal.exchanges.index.title') %></h1>

<p class="fr-text--sm fr-mb-4w fr-col-12 fr-col-md-8"><%= t('admin.journal.exchanges.index.lede') %></p>

<%= render 'filtre' %>

<%= render 'admin/erreurs', errors: @filter.errors %>

<p class="fr-text--sm fr-mb-2w">
  <%= t('admin.journal.exchanges.count', count: @total) %>
</p>

<div class="fr-table fr-table--bordered">
  <div class="fr-table__wrapper">
    <div class="fr-table__container">
      <div class="fr-table__content">
        <table>
          <%# Hidden from the eye: the page title repeats it word for word.
              Never removed for all that — RGAA 5.4 wants a data table to carry
              a title, and a screen reader announces it. %>
          <%= tag.caption(t('admin.journal.exchanges.index.caption'), class: 'fr-sr-only') %>
          <thead>
            <tr>
              <th scope="col"><%= t('admin.journal.exchanges.index.columns.id') %></th>
              <th scope="col"><%= t('admin.journal.exchanges.attributes.status') %></th>
              <th scope="col"><%= t('admin.journal.exchanges.attributes.direction') %></th>
              <th scope="col"><%= t('admin.journal.exchanges.attributes.procedure') %></th>
              <th scope="col"><%= t('admin.solicited_country') %></th>
              <th scope="col"><%= t('admin.journal.exchanges.attributes.requester') %></th>
              <th scope="col"><%= t('admin.journal.exchanges.attributes.opened_at') %></th>
            </tr>
          </thead>
          <tbody>
            <% @exchanges.each do |exchange| %>
              <tr>
                <td>
                  <%= link_to exchange.exchange_id,
                        admin_journal_exchange_path(exchange.exchange_id) %>
                </td>
                <td><%= render ExchangeStatusComponent.new(status: exchange.status) %></td>
                <td>
                  <%= t("admin.journal.exchanges.directions.#{exchange.direction}") %>
                </td>
                <td>
                  <%= render 'admin/country_procedure', procedure_code: exchange.procedure_code,
                                                        country_code: exchange.requester_country_code %>
                </td>
                <td><%= render 'admin/country', country_code: exchange.solicited_country_code %></td>
                <td><%= exchange.evidence_requester_id.presence || '—' %></td>
                <td><%= l(exchange.created_at, format: :short) %></td>
              </tr>
            <% end %>

            <% if @exchanges.empty? %>
              <tr>
                <td colspan="7"><%= t('admin.journal.exchanges.index.empty') %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%= render PaginationComponent.new(
      current: @page,
      pages: @filter.pages(@total),
      link: ->(page) { admin_journal_exchanges_path(@filter.to_query(page: page)) },
    ) %>
