<%# The exchange an event names does not always exist: a response can name one
    France never opened, and a refusal turned away before any exchange was
    opened names none. A link would then lead to a 404. %>
<% if event.exchange %>
  <%= link_to event.exchange_id, admin_journal_exchange_path(event.exchange_id) %>
<% else %>
  <%= event.exchange_id.presence || '—' %>
<% end %>
