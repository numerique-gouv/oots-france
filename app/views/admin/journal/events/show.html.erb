<% content_for :title, t('admin.journal.events.show.title', id: @event.id) %>

<%= render JournalBreadcrumbsComponent.new(
      trail: [[t('admin.journal.events.show.title', id: @event.id), nil]],
    ) %>

<h1 class="fr-h3"><%= t('admin.journal.events.show.title', id: @event.id) %></h1>

<p><%= render EventTypeComponent.new(event_type: @event.event_type) %></p>

<div class="fr-table fr-table--bordered">
  <div class="fr-table__wrapper">
    <div class="fr-table__container">
      <div class="fr-table__content">
        <table>
          <caption><%= t('admin.journal.events.show.caption') %></caption>
          <tbody>
            <%# Which columns there are, in which order, and what each carries:
                `AuditEventPresenter` says all three. %>
            <% @presenter.rows.each do |row| %>
              <tr>
                <th scope="row"><%= row.label %></th>
                <td>
                  <%# Rendered as the table renders them: the detail page must
                      say nothing less, nor say it differently. %>
                  <% cell = capture do %>
                    <% case row.reading %>
                    <% when :timestamp %>
                      <%= l(row.value, format: :long) %>
                    <% when :exchange %>
                      <%= render 'admin/journal/exchange_link', event: @event %>
                    <% when :conversation %>
                      <%= render 'admin/journal/conversation_link', event: @event %>
                    <% when :procedure %>
                      <%= link_to row.value, admin_common_services_procedure_path(row.value),
                            class: 'fr-link fr-link--sm' %>
                    <% when :country %>
                      <%= render 'admin/country', country_code: row.value %>
                    <% when :address %>
                      <%= external_link(row.value) %>
                    <% when :edm_error_code %>
                      <%= render EdmErrorCodeComponent.new(code: row.value) %>
                    <% when :regrep_body %>
                      <%= render RegrepBodyComponent.new(body: row.value) %>
                    <% when :subject %>
                      <%= render EvidenceSubjectComponent.new(value: row.value) %>
                    <% else %>
                      <code><%= row.value %></code>
                    <% end %>
                  <% end %>

                  <%# The mark wraps the cell instead of replacing it, so a column
                      with a reading of its own keeps it the day it is encrypted.
                      Which columns those are is read from the record, never from
                      a list copied here. %>
                  <% if row.encrypted? %>
                    <%= render(DecryptedValueComponent.new(block: row.flow?)) { cell } %>
                  <% else %>
                    <%= cell %>
                  <% end %>
                </td>
              </tr>

              <%# Against the row that names the exchange: the version belongs to
                  the exchange and not to the event, and putting it there says
                  what it refers to. The journal does not record it — `audit_events`
                  has no such column — so it is read off the exchange. %>
              <% if row.reading == :exchange %>
                <%= render 'admin/journal/specification_row', exchange: @event.exchange %>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<% if @event.evidence_subject_key.present? %>
  <p class="fr-mt-2w">
    <%= link_to t('admin.journal.events.show.same_subject'),
          admin_journal_subjects_path(@event.subject_criteria),
          class: 'fr-btn fr-btn--secondary' %>
  </p>
<% end %>
