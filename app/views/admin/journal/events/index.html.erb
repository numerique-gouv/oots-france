<% content_for :title, t('admin.journal.events.index.title') %>

<%= render JournalBreadcrumbsComponent.new %>

<div class="fr-grid-row fr-grid-row--top fr-mb-2w">
  <div class="fr-col-12 fr-col-md-7">
    <h1><%= t('admin.journal.events.index.title') %></h1>
  </div>
  <div class="fr-col-12 fr-col-md-5 fr-mt-md-1w">
    <%# `fr-btns-group--icon-right` is what tells the DSFR that these icons
        accompany a label: without it, the stylesheet reads a group whose buttons
        carry an `fr-icon-*` class as icon-only and squares them off, clipping the
        wording. %>
    <ul class="fr-btns-group fr-btns-group--inline-md fr-btns-group--icon-right fr-btns-group--right">
      <li>
        <%= link_to t('admin.journal.subjects.show.title'), admin_journal_subjects_path,
              class: 'fr-btn fr-btn--secondary fr-btn--icon-right fr-icon-arrow-right-line' %>
      </li>
    </ul>
  </div>
</div>

<p class="fr-text--sm fr-mb-4w fr-col-12 fr-col-md-8">
  <%= t('admin.journal.events.index.lede_html',
        article: link_to(t('admin.journal.events.index.article'),
          'https://eur-lex.europa.eu/eli/reg_impl/2022/1463/oj',
          target: '_blank', rel: 'noopener')) %>
</p>

<%= render 'admin/journal/filtre', filter: @filter, url: admin_journal_root_path %>

<%= render 'admin/erreurs', errors: @filter.errors %>

<p class="fr-text--sm fr-mb-2w"><%= t('admin.journal.events.count', count: @total) %></p>

<%= render 'admin/journal/events', events: @events, hide_caption: true,
      caption: t('admin.journal.events.index.caption'), empty: t('admin.journal.events.index.empty') %>

<%= render PaginationComponent.new(
      current: @page,
      pages: @filter.pages(@total),
      link: ->(page) { admin_journal_root_path(@filter.to_query(page: page)) },
    ) %>
