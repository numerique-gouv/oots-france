<% content_for :title, t('components.admin_breadcrumbs.admin') %>

<h1><%= t('admin.home.show.heading') %></h1>

<%# Two tiles for an agent nobody named administrator, four otherwise: the
    columns widen so that two do not leave half a row empty. %>
<% column = named_administrator? ? 'fr-col-md-3' : 'fr-col-md-6' %>

<div class="fr-grid-row fr-grid-row--gutters">
  <div class="fr-col-12 <%= column %>">
    <%= dsfr_tile(
          title: t('components.directory_breadcrumbs.directories'),
          url: admin_common_services_root_path,
          description: t('admin.home.show.tiles.common_services'),
        ) %>
  </div>
  <% if named_administrator? %>
    <div class="fr-col-12 <%= column %>">
      <%= dsfr_tile(
            title: t('admin.journal.events.index.title'),
            url: admin_journal_root_path,
            description: t('admin.home.show.tiles.journal'),
          ) %>
    </div>
    <div class="fr-col-12 <%= column %>">
      <%= dsfr_tile(
            title: t('layouts.entete.jobs'),
            url: admin_jobs_path,
            description: t('admin.home.show.tiles.jobs'),
          ) %>
    </div>
  <% end %>
  <div class="fr-col-12 <%= column %>">
    <%= dsfr_tile(
          title: t('admin.home.show.tiles.demo_title'),
          url: admin_demo_root_path,
          description: t('admin.home.show.tiles.demo'),
        ) %>
  </div>
</div>
