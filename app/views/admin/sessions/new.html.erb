<% content_for :title, t('admin.sessions.new.title') %>

<h1><%= t('admin.sessions.new.heading') %></h1>

<% if @refused_email %>
  <%= dsfr_alert(type: :error, title: t('admin.sessions.new.refused', domains: @domains.map { |domain| "@#{domain}" }.to_sentence,
        email: @refused_email),
        size: :md, html_attributes: { class: 'fr-mb-4w' }) %>
<% end %>

<div class="fr-grid-row">
  <div class="fr-col-12 fr-col-md-8">
    <% if @pro_connect %>
      <%= dsfr_proconnect_button(target: admin_session_path) %>
    <% else %>
      <p><%= t('admin.sessions.new.undeclared') %></p>
    <% end %>
  </div>
</div>

<% if @development_agent %>
  <div class="fr-mt-6w">
    <p class="fr-text--sm"><%= t('admin.sessions.new.development.lead', email: @development_agent) %></p>
    <%= button_to t('admin.sessions.new.development.button'), admin_development_session_path,
          class: 'fr-btn fr-btn--secondary', data: { turbo: false } %>
  </div>
<% end %>
