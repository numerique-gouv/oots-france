<% content_for :title, t('admin.demo.documents.show.title') %>

<%= render DemoBreadcrumbsComponent.new(
      specification: demo_specification, procedure: @procedure.code,
      trail: [[t('admin.demo.documents.show.title'), nil]],
    ) %>

<%= render 'admin/demo/titre', wording: @procedure %>

<h2 class="fr-h5 fr-mt-6w fr-mb-1v" lang="en"><%= t('admin.demo.documents.show.identity_heading') %></h2>

<p class="fr-col-12 fr-col-md-8 fr-mb-3w" lang="en"><%= t('admin.demo.documents.show.identity') %></p>

<%= render DemoIdentityCardComponent.new(identity: @identity) %>

<% if @unreachable.present? %>
  <%= dsfr_alert(type: :error, title: t('admin.demo.documents.show.unreachable')) do %>
    <%= @unreachable %>
  <% end %>
<% end %>

<h2 class="fr-h5 fr-mt-6w fr-mb-1v" lang="en"><%= t('admin.demo.documents.show.caption') %></h2>

<p class="fr-col-12 fr-col-md-8 fr-mb-3w" lang="en"><%= t('admin.demo.documents.show.evidences') %></p>

<%# A directory that refuses carries a code and raises nothing, so the page
    stands with no card at all — and a heading followed by nothing reads as a
    page that failed to render. What is said is what is known: nothing was
    listed. Why is the directory's business, and its code belongs to the
    console. %>
<% if @requirements.empty? && @unreachable.blank? %>
  <p class="fr-col-12 fr-col-md-8" lang="en"><%= t('admin.demo.documents.show.nothing_listed') %></p>
<% end %>

<%# One card per requirement the procedure rests on, in the order the Evidence
    Broker lists them, and a zone on each that can name what it would ask for:
    requirement 27 of chapter 1 §2 makes the two names a condition of the
    request, and chapter 4.4 §4.2.2 lets the requests themselves run « sequentially
    and/or in parallel ». %>
<% @requirements.each do |requirement| %>
  <%= render requirement_card(requirement) %>
<% end %>

<%# The cards the operator added, under those of the procedure and in the
    order they were added: each is a card like the others, with a cross. %>
<% @added.each do |requirement| %>
  <%= render requirement_card(requirement) %>
<% end %>

<%# Any other requirement the Evidence Broker's catalogue holds, offered as a
    card to add, whether or not the broker ties it to the procedure. Absent
    when the catalogue could not be read: the cards above stand without it. %>
<% if @addable.present? %>
  <div class="fr-col-12 fr-col-md-8 fr-mt-4w" lang="en">
    <h2 class="fr-h6"><%= t('admin.demo.documents.show.add.heading') %></h2>

    <%# The list and its button on one line; the label is said off screen
        only, the heading above already saying what the list is for. %>
    <%= form_with url: admin_demo_cartes_path, method: :post do |form| %>
      <div class="fr-grid-row fr-grid-row--gutters fr-grid-row--middle">
        <div class="fr-col">
          <div class="fr-select-group fr-mb-0">
            <%= form.label :exigence, t('admin.demo.documents.show.add.label'), class: 'fr-label fr-sr-only',
                  for: 'exigence-a-ajouter' %>
            <%# Nothing chosen in advance: the empty first option is the DSFR's,
                and the list is required. `select_tag` and not the form
                builder's `select`, which would add a blank option of its own
                above it. %>
            <%= select_tag :exigence,
                  options_for_select([[t('admin.demo.documents.show.add.placeholder'), '',
                                       { disabled: true, hidden: true }], *@addable], ''),
                  class: 'fr-select fr-mt-0', id: 'exigence-a-ajouter', required: true %>
          </div>
        </div>
        <div class="fr-col-auto">
          <%= form.submit t('admin.demo.documents.show.add.submit'), class: 'fr-btn fr-btn--secondary' %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
