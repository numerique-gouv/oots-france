<% content_for :title, t('admin.demo.documents.show.title') %>

<%= render DemoBreadcrumbsComponent.new(
      trail: [[t('admin.demo.documents.show.title'), nil]],
    ) %>

<%= render 'admin/demo/titre', wording: @procedure %>

<h2 class="fr-h5 fr-mt-6w fr-mb-1v" lang="en"><%= t('admin.demo.documents.show.identity_heading') %></h2>

<p class="fr-col-12 fr-col-md-8 fr-mb-3w" lang="en"><%= t('admin.demo.documents.show.identity') %></p>

<%= render DemoIdentityCardComponent.new(identity: @identity) %>

<% if @unreachable.present? %>
  <%= dsfr_alert(type: :error, title: t('admin.demo.documents.show.unreachable')) do %>
    <%= @unreachable %>
  <% end %>
<% end %>

<h2 class="fr-h5 fr-mt-6w fr-mb-1v" lang="en"><%= t('admin.demo.documents.show.caption') %></h2>

<p class="fr-col-12 fr-col-md-8 fr-mb-3w" lang="en"><%= t('admin.demo.documents.show.evidences') %></p>

<%# A directory that refuses carries a code and raises nothing, so the page
    stands with no card at all — and a heading followed by nothing reads as a
    page that failed to render. What is said is what is known: nothing was
    listed. Why is the directory's business, and its code belongs to the
    console. %>
<% if @requirements.empty? && @unreachable.blank? %>
  <p class="fr-col-12 fr-col-md-8" lang="en"><%= t('admin.demo.documents.show.nothing_listed') %></p>
<% end %>

<%# One card per requirement the procedure rests on, in the order the Evidence
    Broker lists them, and a zone on each that can name what it would ask for:
    requirement 27 of chapter 1 §2 makes the two names a condition of the
    request, and chapter 4.4 §4.2.2 lets the requests themselves run « sequentially
    and/or in parallel ». %>
<% @requirements.each do |requirement| %>
  <%= render DemoRequirementCardComponent.new(wording: requirement,
        country_code: provider_country_code, country_name: provider_country_name,
        zone: (demo_request_zone(requirement) if requirement.nameable?)) %>
<% end %>
