<% content_for :title, t('admin.demo.confirmations.show.title') %>

<%= render DemoBreadcrumbsComponent.new(
      trail: [[t('admin.demo.confirmations.show.title'), nil]],
    ) %>

<%= render 'admin/demo/titre', wording: @procedure %>

<h2 class="fr-h5 fr-mt-4w fr-mb-1v" lang="en"><%= t('admin.demo.confirmations.show.identity_heading') %></h2>

<p class="fr-col-12 fr-col-md-8 fr-mb-3w" lang="en"><%= t('admin.demo.confirmations.show.identity') %></p>

<%= render DemoIdentityCardComponent.new(identity: @identity, wording: @identity_wording) %>

<% if @unreachable.present? %>
  <%= dsfr_alert(type: :error, title: t('admin.demo.confirmations.show.unreachable')) do %>
    <%= @unreachable %>
  <% end %>
<% end %>

<h2 class="fr-h5 fr-mt-4w fr-mb-1v" lang="en"><%= t('admin.demo.confirmations.show.caption') %></h2>

<p class="fr-col-12 fr-col-md-8 fr-mb-3w" lang="en"><%= t('admin.demo.confirmations.show.evidences') %></p>

<%# One card per requirement the procedure rests on, in the order the Evidence
    Broker lists them. %>
<% @requirements.each do |requirement| %>
  <%= render DemoRequirementCardComponent.new(wording: requirement, askable: requirement == @wording,
        country: provider_country) %>
<% end %>
