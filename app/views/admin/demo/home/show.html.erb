<% content_for :title, t('admin.demo.home.show.title') %>

<%= render DemoBreadcrumbsComponent.new %>

<%= render 'admin/demo/titre', wording: @wording %>

<p class="fr-text--lead fr-col-12 fr-col-md-8" lang="en"><%= t('admin.demo.home.show.lead') %></p>

<%# What the Evidence Broker publishes for the procedure, named as it names it.
    The sentence introduces the list and is worth nothing without one, so both
    go or neither does. %>
<% if @wording.requirements_named.any? %>
  <div class="fr-col-12 fr-col-md-8 fr-my-4w" lang="en">
    <p class="fr-mb-1w"><%= t('admin.demo.home.show.requirements') %></p>

    <ul>
      <% @wording.requirements_named.each do |label, language| %>
        <li class="fr-mb-1v"><%= render(DirectoryValueComponent.new(lang: language)) { label } %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%# `button_to` and not a link: starting the European flow writes the `state`
    and the `nonce` its return is checked against, and a GET the browser
    prefetched or replayed would overwrite those of a flow under way. %>
<%= button_to t('admin.demo.home.show.sign_in'), admin_demo_identification_path,
      class: 'fr-btn', lang: 'en' %>
