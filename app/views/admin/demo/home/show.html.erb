<% content_for :title, t('admin.demo.home.show.title') %>

<%= render DemoBreadcrumbsComponent.new %>

<%= render 'admin/demo/titre', wording: @wording %>

<p class="fr-text--lead fr-col-12 fr-col-md-8" lang="en"><%= t('admin.demo.home.show.lead') %></p>

<%# What the Evidence Broker publishes for the procedure, named as it names it.
    The sentence introduces the list and is worth nothing without one, so both
    go or neither does. %>
<% if @wording.requirements_named.any? %>
  <div class="fr-col-12 fr-col-md-8 fr-my-4w" lang="en">
    <p class="fr-mb-1w"><%= t('admin.demo.home.show.requirements') %></p>

    <ul>
      <% @wording.requirements_named.each do |label, language| %>
        <li class="fr-mb-1v"><%= render(DirectoryValueComponent.new(lang: language)) { label } %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%# One card per FranceConnect+ this deployment declares. The demonstration is
    the same from either — the card says which FranceConnect+ attests the
    identity, and nothing else.

    `button_to` and not a link: starting the European flow writes the `state`
    and the `nonce` its return is checked against, and a GET the browser
    prefetched or replayed would overwrite those of a flow under way. The name
    of the FranceConnect+ travels in the body of that same submission.

    The visible label is the same on every card, being the one FranceConnect+
    gives its European flow; the accessible name adds which card it belongs to,
    two buttons reading alike and leading elsewhere being what criterion 11.9 of
    the RGAA refuses. It *wraps* the visible label rather than replacing it, so
    that voice control still finds the button by what it reads (WCAG 2.5.3). %>
<div class="fr-col-12 fr-col-md-8" lang="en">
  <% @france_connect_instances.each do |instance| %>
    <% title = t("admin.demo.home.show.france_connect.#{instance.name}.title") %>
    <% sign_in = t('admin.demo.home.show.sign_in') %>

    <%= render CardComponent.new(title:, heading_level: 2) do %>
      <p class="fr-mb-2w"><%= t("admin.demo.home.show.france_connect.#{instance.name}.lead") %></p>

      <%= button_to sign_in, admin_demo_identification_path,
            params: { france_connect: instance.name }, class: 'fr-btn',
            aria: { label: t('admin.demo.home.show.sign_in_named', label: sign_in, provider: title) } %>
    <% end %>
  <% end %>
</div>
