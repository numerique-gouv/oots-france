<% content_for :title, t('admin.conversations.show.title', id: @conversation.conversation_id) %>

<%= dsfr_breadcrumbs do |fil| %>
  <% fil.with_breadcrumb(label: t('components.directory_breadcrumbs.admin'), href: admin_root_path) %>
  <% fil.with_breadcrumb(label: t('admin.conversations.index.title'), href: admin_conversations_path) %>
  <% fil.with_breadcrumb(label: @conversation.conversation_id) %>
<% end %>

<h1 class="fr-h3"><%= @conversation.conversation_id %></h1>

<p><%= render ConversationStatusComponent.new(status: @conversation.status) %></p>

<div class="fr-table fr-table--bordered">
  <div class="fr-table__wrapper">
    <div class="fr-table__container">
      <div class="fr-table__content">
        <table>
          <caption><%= t('admin.conversations.show.caption') %></caption>
          <tbody>
            <tr>
              <th scope="row"><%= t('admin.conversations.attributes.direction') %></th>
              <td><%= t("admin.conversations.directions.#{@conversation.direction}") %></td>
            </tr>
            <tr>
              <th scope="row"><%= t('admin.conversations.attributes.procedure') %></th>
              <td>
                <%= render 'admin/country_procedure', procedure_code: @conversation.procedure_code,
                                                      country_code: @conversation.requester_country_code %>
              </td>
            </tr>
            <tr>
              <th scope="row"><%= t('admin.solicited_country') %></th>
              <td><%= render 'admin/country', country_code: @conversation.solicited_country_code %></td>
            </tr>
            <tr>
              <th scope="row"><%= t('admin.conversations.attributes.requester') %></th>
              <td><%= @conversation.evidence_requester_id.presence || '—' %></td>
            </tr>
            <tr>
              <th scope="row"><%= t('admin.conversations.attributes.opened_at') %></th>
              <td><%= l(@conversation.created_at, format: :long) %></td>
            </tr>
            <tr>
              <th scope="row"><%= t('admin.conversations.show.rows.settled_at') %></th>
              <td><%= @conversation.settled_at ? l(@conversation.settled_at, format: :long) : '—' %></td>
            </tr>
            <tr>
              <th scope="row"><%= t('admin.conversations.show.rows.edm_error_code') %></th>
              <td><%= @conversation.edm_error_code.presence || '—' %></td>
            </tr>
            <tr>
              <th scope="row"><%= t('admin.conversations.show.rows.preview_location') %></th>
              <%# A foreign correspondent chooses this address: it is read, not
                  followed. An operator console has no business being a
                  one-click launcher into a site it did not choose. %>
              <td><code><%= @conversation.preview_location.presence || '—' %></code></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%# On an outgoing exchange only: the simulation replays the chain of
    directories France walks in order to ask, and answering walks none. %>
<% if !@conversation.incoming? && @conversation.procedure_code.present? && @conversation.country_code.present? %>
  <p class="fr-mt-2w">
    <%= link_to t('admin.conversations.show.simulate'),
          admin_common_services_resolution_path(
            procedure_code: @conversation.procedure_code, country_code: @conversation.country_code,
          ),
          class: 'fr-btn fr-btn--secondary' %>
  </p>
<% end %>

<% if @conversation.error_description.present? %>
  <h2 class="fr-h5 fr-mt-4w"><%= t('admin.conversations.show.failure_reason') %></h2>
  <%= dsfr_callout do %>
    <%= @conversation.error_description %>
  <% end %>
<% end %>

<h2 class="fr-h5 fr-mt-4w"><%= t('admin.conversations.show.journal.caption') %></h2>

<p class="fr-text--sm fr-mb-2w"><%= t('admin.journal.events.count', count: @events.size) %></p>

<%# The caption repeats the section title, so it is hidden from the eye: RGAA
    5.4 wants a data table to carry a title, and it keeps one. %>
<%= render 'admin/journal/events', events: @events, hide_caption: true, caption: t('admin.conversations.show.journal.caption'),
      empty: t('admin.conversations.show.journal.empty') %>
