<soap:Envelope xmlns:soap="http://www.w3.org/2003/05/soap-envelope" xmlns:_1="http://eu.domibus.wsplugin/">
  <soap:Header/>
  <soap:Body>
<%- if access_point_role -%>
    <_1:getErrorsRequestWithAccessPointRole>
      <messageID><%= escape(message_id) %></messageID>
      <accessPointRole><%= escape(access_point_role) %></accessPointRole>
    </_1:getErrorsRequestWithAccessPointRole>
<%- else -%>
    <_1:getErrorsRequest>
      <messageID><%= escape(message_id) %></messageID>
    </_1:getErrorsRequest>
<%- end -%>
  </soap:Body>
</soap:Envelope>
