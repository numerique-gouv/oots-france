<?xml version="1.0" encoding="UTF-8"?>
<query:QueryRequest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns:rs="urn:oasis:names:tc:ebxml-regrep:xsd:rs:4.0"
          xmlns:sdg="http://data.europa.eu/p4s"
          xmlns:xmime="http://www.w3.org/2005/05/xmlmime"
          xmlns:rim="urn:oasis:names:tc:ebxml-regrep:xsd:rim:4.0"
          xmlns:query="urn:oasis:names:tc:ebxml-regrep:xsd:query:4.0"
          xmlns:xlink="http://www.w3.org/1999/xlink"
          xmlns:xml="http://www.w3.org/XML/1998/namespace"
          id="<%= escape(request_id) %>">

  <rim:Slot name="SpecificationIdentifier">
    <rim:SlotValue xsi:type="rim:StringValueType">
      <rim:Value><%= specification.identifier %></rim:Value>
    </rim:SlotValue>
  </rim:Slot>
  <rim:Slot name="IssueDateTime">
    <rim:SlotValue xsi:type="rim:DateTimeValueType">
      <rim:Value><%= timestamp %></rim:Value>
    </rim:SlotValue>
  </rim:Slot>
<%# R-EDM-REQ-S022: the slot holds a `rim:InternationalStringValueType` in
    1.2.5, where 2.0.1 made it a plain `rim:StringValueType`. -%>
<%- if specification.translated_procedure? -%>
  <rim:Slot name="Procedure">
    <rim:SlotValue xsi:type="rim:InternationalStringValueType">
      <rim:Value>
        <rim:LocalizedString xml:lang="<%= EvidenceRequestBuilder::PROCEDURE_LANGUAGE %>" value="<%= escape(procedure_code) %>"/>
      </rim:Value>
    </rim:SlotValue>
  </rim:Slot>
<%- else -%>
  <rim:Slot name="Procedure">
    <rim:SlotValue xsi:type="rim:StringValueType">
      <rim:Value><%= escape(procedure_code) %></rim:Value>
    </rim:SlotValue>
  </rim:Slot>
<%- end -%>
<%# Chapter 4.9 §2 step 12: the second request carries the address the
    correspondent returned, « an exact copy », and on 2.0 where to send the user
    back. -%>
<%- if preview_location.present? -%>
  <rim:Slot name="PreviewLocation">
    <rim:SlotValue xsi:type="rim:StringValueType">
      <rim:Value><%= escape(preview_location) %></rim:Value>
    </rim:SlotValue>
  </rim:Slot>
<%- end -%>
<%- if return_location.present? -%>
  <rim:Slot name="ReturnLocation">
    <rim:SlotValue xsi:type="rim:StringValueType">
      <rim:Value><%= escape(return_location) %></rim:Value>
    </rim:SlotValue>
  </rim:Slot>
<%- end -%>
  <rim:Slot name="PossibilityForPreview">
    <rim:SlotValue xsi:type="rim:BooleanValueType">
      <rim:Value><%= preview_possible %></rim:Value>
    </rim:SlotValue>
  </rim:Slot>
  <rim:Slot name="ExplicitRequestGiven">
    <rim:SlotValue xsi:type="rim:BooleanValueType">
      <rim:Value>true</rim:Value>
    </rim:SlotValue>
  </rim:Slot>
  <rim:Slot name="Requirements">
    <rim:SlotValue xsi:type="rim:CollectionValueType"
      collectionType="urn:oasis:names:tc:ebxml-regrep:CollectionType:Set">
      <rim:Element xsi:type="rim:AnyValueType">
        <sdg:Requirement>
          <sdg:Identifier><%= escape(requirement.id) %></sdg:Identifier>
<%- requirement.descriptions.each do |language, name| -%>
          <sdg:Name lang="<%= escape(language) %>"><%= escape(name) %></sdg:Name>
<%- end -%>
<%- requirement.details.each do |language, description| -%>
          <sdg:Description lang="<%= escape(language) %>"><%= escape(description) %></sdg:Description>
<%- end -%>
        </sdg:Requirement>
      </rim:Element>
    </rim:SlotValue>
  </rim:Slot>
  <rim:Slot name="EvidenceRequester">
    <rim:SlotValue xsi:type="rim:CollectionValueType" collectionType="urn:oasis:names:tc:ebxml-regrep:CollectionType:Set">
      <rim:Element xsi:type="rim:AnyValueType">
<%= requester_agent %>
      </rim:Element>
      <rim:Element xsi:type="rim:AnyValueType">
<%= intermediary_platform_agent %>
      </rim:Element>
    </rim:SlotValue>
  </rim:Slot>
  <rim:Slot name="EvidenceProvider">
    <rim:SlotValue xsi:type="rim:AnyValueType">
<%= provider_agent %>
    </rim:SlotValue>
  </rim:Slot>
<%# Chapter 4.5.1 §3.4: « The SupportedValue class is used for the expression
    of the user provided value … The remaining structure e.g. Identifier, Type,
    Value Expression, Description must be adopted from the corresponding DSD
    QueryResponse ». After `EvidenceProvider`, where the table of slots and the
    published example put it. -%>
<%- if provider_classifications.any? -%>
  <rim:Slot name="EvidenceProviderClassification">
    <rim:SlotValue xsi:type="rim:CollectionValueType" collectionType="urn:oasis:names:tc:ebxml-regrep:CollectionType:Set">
<%- provider_classifications.each do |classification| -%>
      <rim:Element xsi:type="rim:AnyValueType">
        <sdg:EvidenceProviderClassification>
<%- if classification.scheme_id.present? -%>
          <sdg:Identifier schemeID="<%= escape(classification.scheme_id) %>"><%= escape(classification.id) %></sdg:Identifier>
<%- else -%>
          <sdg:Identifier><%= escape(classification.id) %></sdg:Identifier>
<%- end -%>
          <sdg:Type><%= escape(classification.type) %></sdg:Type>
<%- if classification.value_expression.present? -%>
          <sdg:ValueExpression><%= escape(classification.value_expression) %></sdg:ValueExpression>
<%- end -%>
<%- classification.descriptions.each do |language, question| -%>
          <sdg:Description lang="<%= escape(language) %>"><%= escape(question) %></sdg:Description>
<%- end -%>
          <sdg:SupportedValue>
<%- if classification.boolean? -%>
            <sdg:BooleanValue><%= escape(classification.supported_value) %></sdg:BooleanValue>
<%- else -%>
            <sdg:StringValue><%= escape(classification.supported_value) %></sdg:StringValue>
<%- end -%>
          </sdg:SupportedValue>
        </sdg:EvidenceProviderClassification>
      </rim:Element>
<%- end -%>
    </rim:SlotValue>
  </rim:Slot>
<%- end -%>
  <query:ResponseOption returnType="LeafClassWithRepositoryItem"/>
  <query:Query queryDefinition="DocumentQuery">
    <rim:Slot name="<%= subject_slot_name %>">
      <rim:SlotValue xsi:type="rim:AnyValueType">
<%= beneficiary %>
      </rim:SlotValue>
    </rim:Slot>
    <rim:Slot name="EvidenceRequest">
      <rim:SlotValue xsi:type="rim:AnyValueType">
<%= data_service_evidence_type %>
      </rim:SlotValue>
    </rim:Slot>
  </query:Query>
</query:QueryRequest>
