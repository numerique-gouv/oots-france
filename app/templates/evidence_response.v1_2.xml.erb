<query:QueryResponse
        xmlns:query="urn:oasis:names:tc:ebxml-regrep:xsd:query:4.0"
        xmlns:rim="urn:oasis:names:tc:ebxml-regrep:xsd:rim:4.0"
        xmlns:sdg="http://data.europa.eu/p4s"
        xmlns:xlink="http://www.w3.org/1999/xlink"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        status="urn:oasis:names:tc:ebxml-regrep:ResponseStatusType:Success"
        requestId="<%= escape(request_id) %>">

  <rim:Slot name="SpecificationIdentifier">
    <rim:SlotValue xsi:type="rim:StringValueType">
      <rim:Value><%= specification.identifier %></rim:Value>
    </rim:SlotValue>
  </rim:Slot>

  <rim:Slot name="EvidenceResponseIdentifier">
    <rim:SlotValue xsi:type="rim:StringValueType">
      <rim:Value><%= escape(document_id) %></rim:Value>
    </rim:SlotValue>
  </rim:Slot>

  <rim:Slot name="IssueDateTime">
    <rim:SlotValue xsi:type="rim:DateTimeValueType">
      <rim:Value><%= timestamp %></rim:Value>
    </rim:SlotValue>
  </rim:Slot>

  <rim:Slot name="EvidenceProvider">
    <rim:SlotValue xsi:type="rim:CollectionValueType" collectionType="urn:oasis:names:tc:ebxml-regrep:CollectionType:Set">
      <rim:Element xsi:type="rim:AnyValueType">
<%= provider_agent %>
      </rim:Element>
    </rim:SlotValue>
  </rim:Slot>

  <rim:Slot name="EvidenceRequester">
    <rim:SlotValue xsi:type="rim:AnyValueType">
<%= requester_agent %>
    </rim:SlotValue>
  </rim:Slot>

<%# R-EDM-RESP-S015 and -S033 anchor on the objects of the list itself: in 1.2
    the evidence is described on the top-level object, where 2.0 wraps them in a
    `rim:RegistryPackageType`. No `rim:Classification` either — the 1.2 rules
    forbid none, but 1.2 has no `MainEvidence` to name, one response carrying
    one document. -%>
  <rim:RegistryObjectList>
    <rim:RegistryObject xsi:type="rim:ExtrinsicObjectType" id="urn:uuid:<%= escape(extrinsic_object_id) %>">
      <rim:Slot name="EvidenceMetadata">
        <rim:SlotValue xsi:type="rim:AnyValueType">
          <sdg:Evidence>
            <sdg:Identifier><%= escape(evidence_id) %></sdg:Identifier>
            <sdg:IsAbout>
<%= evidence_subject %>
            </sdg:IsAbout>
            <sdg:IssuingAuthority>
              <sdg:Identifier schemeID="<%= escape(provider_identity.type_id) %>"><%= escape(provider_identity.id) %></sdg:Identifier>
<%- provider_names.each do |language, text| -%>
              <sdg:Name lang="<%= escape(language) %>"><%= escape(text) %></sdg:Name>
<%- end -%>
            </sdg:IssuingAuthority>
            <sdg:IsConformantTo>
              <sdg:EvidenceTypeClassification><%= escape(evidence_type.id) %></sdg:EvidenceTypeClassification>
<%- evidence_type.descriptions.each do |language, title| -%>
              <sdg:Title lang="<%= escape(language) %>"><%= escape(title) %></sdg:Title>
<%- end -%>
            </sdg:IsConformantTo>
            <sdg:IssuingDate><%= EvidenceResponseBuilder::ISSUING_DATE %></sdg:IssuingDate>
            <sdg:Distribution>
              <sdg:Format><%= escape(served_format) %></sdg:Format>
            </sdg:Distribution>
          </sdg:Evidence>
        </rim:SlotValue>
      </rim:Slot>
      <rim:RepositoryItemRef xlink:href="<%= escape(attachment.identifier) %>" xlink:title="Evidence"/>
    </rim:RegistryObject>
  </rim:RegistryObjectList>
</query:QueryResponse>
