<nav class="fr-pagination" role="navigation" aria-label="Pagination">
  <ul class="fr-pagination__list">
    <li><%= edge_link(t('components.pagination.previous'), previous_page, 'prev') %></li>

    <% numbers.each do |number| %>
      <li>
        <%= link_to number, href(number),
              class: 'fr-pagination__link',
              title: t('components.pagination.page', number: number),
              **(current?(number) ? { 'aria-current': 'page' } : {}) %>
      </li>
    <% end %>

    <li><%= edge_link(t('components.pagination.next'), next_page, 'next') %></li>
  </ul>
</nav>
