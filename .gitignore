.env*
!.env*.template
/domibus/
/nginx/
docs/prompts/
docker-compose.override.yml
# Le travail d'atelier reste local (plans, audits, revues, reprises) ; les
# skills et les agents, eux, sont versionnés : ils décrivent comment on
# travaille sur ce dépôt.
.claude/*
!.claude/agents/
!.claude/skills/
CLAUDE.local.md
.worktrees/

# Schematron validation artefacts (downloaded)
.schematron/

# Rails credentials decryption key: never versioned
/config/master.key

# Bundler's local configuration
/.bundle

# logs and temporary files
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/.keep

# assets compiled by Propshaft
/public/assets

# gems installed locally
/vendor/bundle

# SimpleCov coverage report
/coverage
