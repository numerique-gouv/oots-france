# Contrat et valeurs d'un poste de développement, comme .env.template, dont
# l'entête dit ce que cela recouvre.
#
# Un serveur porte deux variables de plus, que ce template ne déclare pas parce
# qu'elles ne doivent exister qu'avec une valeur : RAILS_ENV=production et
# SECRET_KEY_BASE. Déclarées vides ici, les suites de tests tourneraient en
# development. `scripts/setup_server.sh` les pose, et docs/deploiement.md dit
# pourquoi c'est avant `make setup` que cela se joue.
AVEC_REQUETE_PIECE_JUSTIFICATIVE=true # commande l'API /requete/pieceJustificative ; laissée vide elle reste verrouillée, seul true l'ouvre, et rien d'autre n'est accepté
CLE_PRIVEE_JWK_EN_BASE64= # Cle privée utilisée pour déchiffrer les infos (données au format JWK, chiffrées en base64)
CLE_PRIVEE_JWK_DEMARCHE_EN_BASE64= # clé privée de la démarche de démonstration, celle que FranceConnect+ chiffre l'ID Token et la réponse UserInfo pour (JWK encodée en base64) ; son alg doit valoir RSA-OAEP-256 ou ECDH-ES, seuls acceptés par FranceConnect+
CLE_PRIVEE_JWK_SIGNATURE_DEMARCHE_EN_BASE64= # clé privée dont la démarche de démonstration signe le jeton du bénéficiaire qu'elle émet (JWK encodée en base64) ; courbe P-256, le jeton se signant en ES256 et rien d'autre — les deux clés ci-dessus, elles, déchiffrent ce qu'on nous envoie
DONNEES_REQUETEURS={"00000000000002":{"nom":"Requêteur de test","url":"http://web:4000"},"00000000000003":{"nom":"Université de démonstration","url":"http://web:3000/demo"}} # annuaire des fournisseurs de service requêteurs, indexé par leur SIRET ; chaque entrée porte son nom et l'URL sous laquelle il publie ses clés de signature (<url>/auth/cles_publiques) et reçoit le justificatif (POST <url>/oots/document?echange=…&conversation=…, corps = le PDF nu) ; sur la pile locale, ces adresses sont joignables depuis le worker, qui remet le justificatif — d'où un nom de service docker et non localhost
IDENTIFIANT_FOURNISSEUR_FRANCAIS=00000000000001 # SIRET (14 chiffres) de l'organisation française qui fournit le justificatif (C4), annoncé dans les réponses
IDENTIFIANT_REQUETEUR_DEMARCHE=00000000000003 # SIRET (14 chiffres) sous lequel la démarche de démonstration est inscrite dans DONNEES_REQUETEURS ; elle joue C1 quand la variable ci-dessus joue C4, deux rôles que les TDD séparent
NOM_FOURNISSEUR_FRANCAIS=Direction interministérielle du numérique # nom de cette organisation
URL_OOTS_FRANCE=http://localhost:3000 # URL Serveur OOTS-France, ex. https://oots.gouv.fr ; en local http://localhost:<PORT_OOTS_FRANCE>, le serveur écoutant le port qu'il publie, si bien que la même adresse vaut pour le navigateur et depuis le conteneur
URL_FAUX_FRANCE_CONNECT=http://localhost:3100/api/v2 # issuer du faux FranceConnect+ du dépôt, l'adresse à laquelle il répond et dont il compose chaque endpoint de sa découverte ; unique pour le navigateur de l'hôte comme pour le conteneur. Sur un poste elle porte PORT_FAUX_FRANCE_CONNECT, derrière un frontal qui termine TLS elle porte celui du frontal et le faux écoute PORT_FAUX_FRANCE_CONNECT — laissée vide avec les deux suivantes, l'accueil de la démarche n'offre pas sa carte, voir docs/test_e2e.md
IDENTIFIANT_CLIENT_FAUX_FRANCE_CONNECT=oots-france-demarche # client_id que le faux FranceConnect+ connaît la démarche sous ; constante du dépôt, publique
SECRET_CLIENT_FAUX_FRANCE_CONNECT=faux-france-connect-secret-de-la-demarche # client_secret correspondant, présenté dans le corps de l'appel à /token ; constante du dépôt, publique — jamais celui du vrai
URL_VRAI_FRANCE_CONNECT= # issuer du vrai FranceConnect+ dont la démarche déduit sa découverte, ex. https://auth.integ01.dev-franceconnect.fr/api/v2 pour le bac à sable ; vide avec les deux suivantes sur un poste et en intégration continue, le bac à sable exigeant un domaine déclaré
IDENTIFIANT_CLIENT_VRAI_FRANCE_CONNECT= # client_id du fournisseur de service que le vrai FranceConnect+ a délivré à la démarche
SECRET_CLIENT_VRAI_FRANCE_CONNECT= # client_secret correspondant, délivré par le vrai FranceConnect+ et engendré par lui seul

CERTIFICATS_SERVICES_COMMUNS=config/certificats/services_communs_acc.pem # magasin PEM vérifiant la signature des réponses des annuaires, un par environnement — `services_communs_prod.pem` en face de l'environnement `prod`
DELAI_MAX_SERVICES_COMMUNS=10000 # délai maximum d'attente d'une réponse d'annuaire (en millisecondes)
DUREE_CACHE_SERVICES_COMMUNS=3600 # durée de fraîcheur des réponses des annuaires (en secondes)
ENVIRONNEMENT_SERVICES_COMMUNS=acc # environnement des annuaires centraux : acc ou prod
PAYS_SERVICES_COMMUNS=FR # code pays dont l'enregistrement DNS désigne l'instance à interroger
URL_BASE_EVIDENCE_BROKER= # adresse de l'instance Evidence Broker ; renseignée, elle remplace la découverte DNS — à laisser vide sauf mandataire de cache, ex. http://cache.interne/eb
URL_BASE_DATA_SERVICE_DIRECTORY= # adresse de l'instance Data Service Directory ; idem, ex. http://cache.interne/dsd

DELAI_MAX_ATTENTE_DOMIBUS=30000 # délai maximum d'attente d'une réponse Domibus à une requête envoyée (en millisecondes)
IDENTIFIANT_EXPEDITEUR_DOMIBUS=AP_FR_01 # identifiant de notre point d'accès, celui que le PMode déclare et que le DSD publie
SUFFIXE_IDENTIFIANTS_DOMIBUS=oots.eu # suffixe à ajouter dans les trames EBMS
TYPE_IDENTIFIANT_EXPEDITEUR_DOMIBUS=urn:oasis:names:tc:ebcore:partyid-type:unregistered:FR # son schéma de nommage (chapitre 4.7 des TDD)
URL_BASE_DOMIBUS=http://domibus:8080/domibus # URL instance Domibus, ex. https://domibus.gouv.fr

LOGIN_API_REST=oots_ci # Login utilisé pour accéder à l'API REST de DOMIBUS
MOT_DE_PASSE_API_REST=Ci-OotsFrance-2026! # Mot de passe utilisé pour accéder à l'API REST de DOMIBUS
LOGIN_NOTIFICATION_DOMIBUS=domibus_push # Login que Domibus pose sur les notifications qu'il nous envoie (wsplugin.push.auth.username)
MOT_DE_PASSE_NOTIFICATION_DOMIBUS=Push-OotsFrance-2026! # Mot de passe correspondant (wsplugin.push.auth.password)

AVEC_DELAI_EXPIRATION= # commande le dispositif d'expiration du chapitre 4.4.3 des TDD ; laissée vide il s'applique, seul false le retire, et rien d'autre n'est accepté
DELAI_EXPIRATION_REQUETEUR_MINUTES=6 # délai au-delà duquel un échange que la France a ouvert est déclaré expiré, en minutes ; doit dépasser le délai fournisseur (tableau 4.4.3 des TDD : 6) ; inutile si le dispositif est retiré
DELAI_EXPIRATION_FOURNISSEUR_MINUTES=5 # délai au-delà duquel la France répond une erreur d'expiration au lieu du justificatif, en minutes (tableau 4.4.3 des TDD : 5) ; inutile si le dispositif est retiré
DELAI_RESERVATION_REMISE_MINUTES=6 # durée pendant laquelle une remise en cours est réservée à son worker, en minutes ; trop courte, deux workers remettent le même justificatif ; trop longue, une réponse tardive attend derrière une réservation que personne ne tient

CLE_CHIFFREMENT_JOURNAL=journal_cle_de_chiffrement_pour_integration_continue # clé de chiffrement du journal des échanges (32 caractères au moins) ; `rails db:encryption:init` en engendre un jeu
CLE_CHIFFREMENT_DETERMINISTE_JOURNAL=journal_cle_deterministe_pour_integration_continue # clé de chiffrement déterministe, pour les colonnes du journal qui doivent rester interrogeables
SEL_DERIVATION_CLES_JOURNAL=journal_sel_de_derivation_pour_integration_continue # sel de dérivation des deux clés ci-dessus
DUREE_RETENTION_JOURNAL_MOIS=12 # durée de conservation du journal des échanges, en mois ; l'article 17 en impose douze au minimum

HOTE_BASE_DE_DONNEES=postgres # hôte PostgreSQL : le nom du service dans docker-compose.yml
PORT_BASE_DE_DONNEES=5432 # port PostgreSQL, celui sur lequel le conteneur écoute
UTILISATEUR_BASE_DE_DONNEES=oots_france # doit valoir POSTGRES_USER de .env.postgres
MOT_DE_PASSE_BASE_DE_DONNEES=oots_france # doit valoir POSTGRES_PASSWORD de .env.postgres
NOM_BASE_DE_DONNEES=oots_france # doit valoir POSTGRES_DB de .env.postgres ; la suite de tests y ajoute le suffixe _test
UTILISATEUR_APPLICATIF_BASE_DE_DONNEES=oots_france_app # rôle restreint avec lequel web et worker se connectent, distinct du propriétaire ci-dessus ; laissé vide, ils se connectent en propriétaire
MOT_DE_PASSE_APPLICATIF_BASE_DE_DONNEES=oots_france_app # mot de passe de ce rôle, que `rails db:privileges` pose sur lui
