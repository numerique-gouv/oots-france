AVEC_REQUETE_PIECE_JUSTIFICATIVE= # active l'API /requete/pieceJustificative avec valeur true
CLE_PRIVEE_JWK_EN_BASE64= # Cle privée utilisée pour déchiffrer les infos (données au format JWK, chiffrées en base64)
DONNEES_REQUETEURS= # annuaire des fournisseurs de service requêteurs, indexé par leur SIRET
IDENTIFIANT_FOURNISSEUR_FRANCAIS= # SIRET (14 chiffres) de l'organisation française qui fournit le justificatif (C4), annoncé dans les réponses
NOM_FOURNISSEUR_FRANCAIS= # nom de cette organisation, ex. Direction interministérielle du numérique
URL_OOTS_FRANCE= # URL Serveur OOTS-France, ex. https://oots.gouv.fr

CERTIFICATS_SERVICES_COMMUNS= # magasin PEM vérifiant la signature des réponses des annuaires, un par environnement, ex. config/certificats/services_communs_acc.pem
DELAI_MAX_SERVICES_COMMUNS= # délai maximum d'attente d'une réponse d'annuaire (en millisecondes)
DUREE_CACHE_SERVICES_COMMUNS= # durée de fraîcheur des réponses des annuaires (en secondes)
ENVIRONNEMENT_SERVICES_COMMUNS= # environnement des annuaires centraux : acc ou prod
PAYS_SERVICES_COMMUNS= # code pays dont l'enregistrement DNS désigne l'instance à interroger, ex. FR

DELAI_MAX_ATTENTE_DOMIBUS= # délai maximum d'attente d'une réponse Domibus à une requête envoyée (en millisecondes)
IDENTIFIANT_EXPEDITEUR_DOMIBUS= # identifiant expéditeur Domibus
SUFFIXE_IDENTIFIANTS_DOMIBUS= # suffixe à ajouter dans les trames EBMS, ex. oots.eu
TYPE_IDENTIFIANT_EXPEDITEUR_DOMIBUS= # type d'identifiant expéditeur Domibus
URL_BASE_DOMIBUS= # URL instance Domibus, ex. https://domibus.gouv.fr

LOGIN_API_REST= # Login utilisé pour accéder à l'API REST de DOMIBUS
MOT_DE_PASSE_API_REST= # Mot de passe utilisé pour accéder à l'API REST de DOMIBUS
LOGIN_NOTIFICATION_DOMIBUS= # Login que Domibus pose sur les notifications qu'il nous envoie (wsplugin.push.auth.username)
MOT_DE_PASSE_NOTIFICATION_DOMIBUS= # Mot de passe correspondant (wsplugin.push.auth.password)

HOTE_BASE_DE_DONNEES= # hôte PostgreSQL, ex. postgres (le nom du service dans docker-compose.yml)
PORT_BASE_DE_DONNEES= # port PostgreSQL, ex. 5432
UTILISATEUR_BASE_DE_DONNEES= # doit valoir POSTGRES_USER de .env.postgres
MOT_DE_PASSE_BASE_DE_DONNEES= # doit valoir POSTGRES_PASSWORD de .env.postgres
NOM_BASE_DE_DONNEES= # doit valoir POSTGRES_DB de .env.postgres ; la suite de tests y ajoute le suffixe _test
